  earlyLeaveDeduction    Decimal                   @default(0) @map("early_leave_deduction") @db.Decimal(18, 4)
  performanceAmount      Decimal                   @default(0) @map("performance_amount") @db.Decimal(18, 4)
  allowanceAmount        Decimal                   @default(0) @map("allowance_amount") @db.Decimal(18, 4)
  housingAllowance       Decimal                   @default(0) @map("housing_allowance") @db.Decimal(18, 4)
  socialInsurance        Decimal                   @default(0) @map("social_insurance") @db.Decimal(18, 4)
  individualTax          Decimal                   @default(0) @map("individual_tax") @db.Decimal(18, 4)
  otherAdjustment        Decimal                   @default(0) @map("other_adjustment") @db.Decimal(18, 4)
  sourceSnapshot         Json                      @map("source_snapshot")
  status                 String                    @default("draft") @db.VarChar(30)
  attachment             Json                      @default("[]")
  remark                 String?                   @db.VarChar(1000)
  createdAt              DateTime                  @default(now()) @map("created_at")
