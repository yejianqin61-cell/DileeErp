model Bank {
  id                        String                          @id @default(uuid()) @db.Uuid
  bankCode                  String                          @unique @map("bank_code") @db.VarChar(80)
  bankName                  String                          @map("bank_name") @db.VarChar(200)
  accountName               String                          @map("account_name") @db.VarChar(200)
  accountNumber             String                          @map("account_number") @db.VarChar(100)
  currency                  String                          @db.VarChar(10)
  /// 建账期初余额：系统余额 = 期初余额 + 生效收支流水 + 互转净额（见 docs/design/bank-balance-and-transfer-2026-09-16.md）。
  /// 单独一列而不是从流水倒推：财务接手的账户本来就有余额，没有期初就永远对不上银行对账单。
  openingBalance            Decimal                         @default(0) @map("opening_balance") @db.Decimal(18, 4)
  isActive                  Boolean                         @default(true) @map("is_active")
  swiftCode                 String?                         @map("swift_code") @db.VarChar(50)
  remark                    String?                         @db.VarChar(1000)
  createdAt                 DateTime                        @default(now()) @map("created_at")
  updatedAt                 DateTime                        @updatedAt @map("updated_at")
  createdBy                 String                          @map("created_by") @db.Uuid
  updatedBy                 String                          @map("updated_by") @db.Uuid
  deletedAt                 DateTime?                       @map("deleted_at")
  deletedBy                 String?                         @map("deleted_by") @db.Uuid
  payableReconciliations    SupplierPayableReconciliation[]
  supplierPayments          SupplierPayment[]
  customerPayments          CustomerPayment[]
  salaryPayments            SalaryPayment[]
  receivableReconciliations ReceivableReconciliation[]
  cashFlowEntries           CashFlowEntry[]
  transfersOut              BankTransfer[]                  @relation("BankTransferFrom")
  transfersIn               BankTransfer[]                  @relation("BankTransferTo")
  voucherLines              VoucherLine[]

  @@map("banks")
}

/// 银行余额互转：同一个银行池内两个账户之间的资金划转（含跨币种）。
///
/// 为什么不写成两条 CashFlowEntry：互转既不是收入也不是支出，记成「A 支出 + B 收入」会让
/// 收支汇总表凭空多出一笔收入与一笔支出（收支口径被污染）。资金确实动了，但它动在银行账户之间，
/// 因此单独一张表，只在计算**银行余额**时参与：转出方 −fromAmount、转入方 +toAmount。
/// 收支明细表因此不出现互转行 —— 这是有意的口径，不是遗漏。
model BankTransfer {
  id             String    @id @default(uuid()) @db.Uuid
  transferNo     String    @unique @map("transfer_no") @db.VarChar(100)
  transferDate   DateTime  @map("transfer_date") @db.Date
  fromBankId     String    @map("from_bank_id") @db.Uuid
  /// 本方币种：默认取账户币种，但允许与账户币种不同（多币种户要能指定实际扣的币种）。
  fromCurrency   String    @map("from_currency") @db.VarChar(10)
  toBankId       String    @map("to_bank_id") @db.Uuid
  toCurrency     String    @map("to_currency") @db.VarChar(10)
  fromAmount     Decimal   @map("from_amount") @db.Decimal(18, 4)
  /// 对方金额：跨币种时由财务填实际到账数；同币种时必须与 fromAmount 相等（否则是凭空多钱或少钱）。
  toAmount       Decimal   @map("to_amount") @db.Decimal(18, 4)
  /// 汇率快照（toAmount / fromAmount）：同币种为 1。存下来是为了事后能解释「当时按什么价换的」。
  exchangeRate   Decimal?  @map("exchange_rate") @db.Decimal(18, 6)
  /// posted（生效）/ reversed（已冲销，保留行但不再计入余额）
  status         String    @default("posted") @db.VarChar(30)
  reversalReason String?   @map("reversal_reason") @db.VarChar(500)
  remark         String?   @map("remark") @db.VarChar(1000)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String    @map("created_by") @db.Uuid
  updatedBy      String    @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by") @db.Uuid
  fromBank       Bank      @relation("BankTransferFrom", fields: [fromBankId], references: [id])
  toBank         Bank      @relation("BankTransferTo", fields: [toBankId], references: [id])

  @@index([transferDate, status])
  @@index([fromBankId, status])
  @@index([toBankId, status])
  @@map("bank_transfers")
}

/// 库存盘点单（仓库，用户 2026-09-16：「仓库模块增加一个盘点管理，可以将每月一次的盘点数据
/// 导入系统，调整库存物料数量。物料的产品代码作为唯一性」）。
///
/// 与已确认的盘点口径一致（docs/design/warehouse-module-design.md §6，集中待确认事项 28）：
/// **盘点不直接改库存余额**，确认时按行生成独立的库存调整事实（inventory_facts），并留下审计。
/// 于是「导入」只建一张草稿单：确认前随时可改可删（草稿不是业务事实），确认后只能冲销。
model Stocktake {
  id             String          @id @default(uuid()) @db.Uuid
  stocktakeNo    String          @unique @map("stocktake_no") @db.VarChar(100)
  /// 盘点月份 YYYY-MM。用户口径是「每月一次」，按月份归档才能和纸质盘点表对上。
  periodMonth    String          @map("period_month") @db.VarChar(7)
  /// draft（草稿：可改可删）| confirmed（已确认：已写库存调整）| reversed（已冲销）
  status         String          @default("draft") @db.VarChar(30)
  /// 导入来源文件名。盘点表是外部 Excel，事后必须能说清这张单子从哪个文件来。
  sourceFileName String?         @map("source_file_name") @db.VarChar(300)
  importedAt     DateTime?       @map("imported_at")
  confirmedAt    DateTime?       @map("confirmed_at")
  confirmedBy    String?         @map("confirmed_by") @db.Uuid
  reversedAt     DateTime?       @map("reversed_at")
  reversedBy     String?         @map("reversed_by") @db.Uuid
  reversalReason String?         @map("reversal_reason") @db.VarChar(1000)
  remark         String?         @db.VarChar(1000)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  createdBy      String          @map("created_by") @db.Uuid
  updatedBy      String          @map("updated_by") @db.Uuid
  deletedAt      DateTime?       @map("deleted_at")
  deletedBy      String?         @map("deleted_by") @db.Uuid
  lines          StocktakeLine[]

  @@index([periodMonth, status])
  @@map("stocktakes")
}

/// 盘点明细行。一行 = 盘点表里的一行（产品代码 + 仓位 + 货位 + 实盘数）。
///
/// 三个数量快照必须分开存，否则事后解释不清「为什么差异和我导进来时看到的不一样」：
///   - `bookQuantitySnapshot`：**导入时**的账面数，操作员当时看到的数，只作展示；
///   - `bookQuantityAtConfirm`：**确认时**的账面数，真正参与计算的那个数；
///   - `appliedQuantity`：确认时实际写进库存事实的差额（= 实盘数 − 确认时账面数）。
/// 导入与确认之间仓库可能又发生了领料/入库；按确认时账面重算，才不会把那些真实收发悄悄冲掉
/// （用户 2026-09-16 已确认这一条）。
///
/// `warehouseZone` / `binLocation` 是**文本记录**，不是库位维度：V1 已确认不建库位主数据
/// （集中待确认事项 1），这里原样收下是为了能和纸质盘点表逐行对照、找货。
/// 同一产品代码出现在多个仓位时按物料合并后再与账面比（见 stocktake-import.ts 的口径）。
model StocktakeLine {
  id                    String          @id @default(uuid()) @db.Uuid
  stocktakeId           String          @map("stocktake_id") @db.Uuid
  /// 盘点表内的行号（1 起，按文件顺序）：报错与对表都用它。
  lineNo                Int             @map("line_no")
  materialId            String          @map("material_id") @db.Uuid
  /// 产品代码 = 物料编码（用户 2026-09-16 确认两者是同一个字段）。存快照是为了物料改名/改码后
  /// 还能还原「当时盘的是哪一行」。
  productCodeSnapshot   String          @map("product_code_snapshot") @db.VarChar(80)
  productNameSnapshot   String          @map("product_name_snapshot") @db.VarChar(200)
  specificationSnapshot String?         @map("specification_snapshot") @db.VarChar(200)
  warehouseZone         String?         @map("warehouse_zone") @db.VarChar(100)
  binLocation           String?         @map("bin_location") @db.VarChar(100)
  /// 盘点单位固定取物料的默认单位：跨单位相加没有意义，V1 也不做单位换算（集中待确认事项 4）。
  unitId                String          @map("unit_id") @db.Uuid
  /// 实盘数：允许 0（整箱盘没了就是 0，这正是盘亏要记的事），不允许负数。
  actualQuantity        Decimal         @map("actual_quantity") @db.Decimal(18, 4)
  bookQuantitySnapshot  Decimal         @map("book_quantity_snapshot") @db.Decimal(18, 4)
  differenceSnapshot    Decimal         @map("difference_snapshot") @db.Decimal(18, 4)
  bookQuantityAtConfirm Decimal?        @map("book_quantity_at_confirm") @db.Decimal(18, 4)
  appliedQuantity       Decimal?        @map("applied_quantity") @db.Decimal(18, 4)
  differenceReason      String?         @map("difference_reason") @db.VarChar(1000)
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  createdBy             String          @map("created_by") @db.Uuid
  updatedBy             String          @map("updated_by") @db.Uuid
  stocktake             Stocktake       @relation(fields: [stocktakeId], references: [id])
  material              Material        @relation(fields: [materialId], references: [id])
  unit                  Unit            @relation(fields: [unitId], references: [id])
  inventoryFacts        InventoryFact[]

  @@unique([stocktakeId, lineNo])
  @@index([materialId])
  @@index([stocktakeId])
  @@map("stocktake_lines")
}

/// 月度管理费分摊登记（财务，用户 2026-09-20 交付 `example/财务/核算表.xlsx`）。
///
/// 财务原话：「只有采购输入原材料，物控有录人工费。我这边录管理费，就可以出这个表。我这里的管理费
/// 是一个月的所以费用的总合平摊在本月生产的总数量中。比如这个月管理费是22万，生产了4000打货，
/// 管理费就是55元」。
///
/// 为什么必须单独一张表，而不是直接汇总「本月管理费用类科目的收支流水」：
/// 财务的口径是**先有总额、再有费率**（费率 = 总额 ÷ 本月生产数量），而且这个总额是「财务确认过的
/// 这个月的管理费」，不是「这个月已经记进流水的管理费用」—— 流水常常滞后于出表时间（月底的费用
/// 下个月才报销），直接汇总流水会让本月费率凭空偏低，而报表上看不出这一点。
///
/// 为什么 `period` 是唯一键、且软删除后仍占着这个期间：一个期间只该有一条管理费口径，
/// 两条并存就会有「用哪条算费率」的歧义。财务录错时改这一条或删掉再录，服务层按期间 upsert
/// （**包括把已软删的那条恢复回来**），所以唯一索引在软删后仍然成立。
///
/// 金额没有 `currency` 列：管理费是内账的人民币口径（核算表本身就是人民币口径的本币报表，
/// 见 finance-report.tables.ts 里核算表的口径说明）。
model OverheadAllocation {
  id               String    @id @default(uuid()) @db.Uuid
  /// 期间 YYYY-MM（与凭证 / 盘点月份同一写法）。
  period           String    @unique @db.VarChar(7)
  /// 本月管理费总额（人民币）。
  amount           Decimal   @db.Decimal(18, 4)
  /// 分摊单位（打 / 支…）。单位是**登记的一部分**：老核算表没有单位列，而「55 元/打」与
  /// 「55 元/支」差 12 倍；全站的纪律是「不跨单位相加」，所以核算表只对单位一致的订单套费率，
  /// 不一致的留空并在表尾点名。
  unit             String    @db.VarChar(30)
  /// 分摊数量的人工覆盖值。留空 = 由「本月计件日报（employee_daily_reports）的数量」自动汇总。
  /// 自动值只是参考（计件日报按人按工序逐条填报，跨工序合计会重复计一件货），财务可以覆盖。
  quantityOverride Decimal?  @map("quantity_override") @db.Decimal(18, 4)
  remark           String?   @db.VarChar(1000)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdBy        String    @map("created_by") @db.Uuid
  updatedBy        String    @map("updated_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by") @db.Uuid

  @@map("overhead_allocations")
}

/// 收/付款单的存档（用户 2026-09-26：「付款单要有填写汇率的地方，**保存键**」）。
///
/// **口径的变化要说清**：2026-09-20 那一轮的口径是「单子不落库 —— 它是一张打印件，不是系统单据」，
/// 所以它只预填 + 编辑 + 导出。现在用户要一个「保存键」，于是它落库了，但**仍然不是账务单据**：
/// 保存不改任何账（不写收支流水、不生成凭证、不动应付/应收状态），金额与科目仍以界面提交的内容为准。
/// 落库解决的是另一个问题：财务改到一半关掉弹窗，那张单子就没了 —— 一次集中付款十几张，
/// 她只能从头再勾一遍、再改一遍。
///
/// 为什么分录行是**从表**而不是一个 JSON 列：金额落在 `DECIMAL` 列上时，「这一侧没有金额」
/// 只能是 `NULL`（写 0 会被读成「确实为零」的事实）—— JSON 里做不到这条，而它与凭证分录
/// （`VoucherLine`）本就该同形状。
///
/// `sourceEntryIds` **刻意不建外键**：条目可以被删掉，而这张单子已经打出去、必须留着。
model FinanceSlip {
  id                      String            @id @default(uuid()) @db.Uuid
  /// payment（付款单）/ receipt（收款单）。两种单据共用一张表与一套代码，只有用词不同。
  kind                    String            @db.VarChar(20)
  /// 单据编号（模板上的 `FK-202609-001`）。系统给**建议值**，财务可以改成自己本子上的号，
  /// 所以这里**不是唯一键** —— 她的本子上本来就可能重号，加唯一约束会让她导出不了。
  slipNo                  String            @map("slip_no") @db.VarChar(100)
  slipDate                DateTime          @map("slip_date") @db.Date
  slipMethod              String            @map("slip_method") @db.VarChar(50)
  counterpartyName        String            @map("counterparty_name") @db.VarChar(200)
  /// 币种（模板上没有这一格，但汇率与折合人民币离开币种就读不懂，见 R6）。
  currency                String            @default("CNY") @db.VarChar(10)
  /// 汇率快照（人民币付款留空）。8 位小数与 `exchange_rates.rate` 同精度 —— `money.ts` 是
  /// 汇率口径的唯一实现，为一个字段再定一套 6 位精度就是第二份口径。
  exchangeRate            Decimal?          @map("exchange_rate") @db.Decimal(18, 8)
  /// 折合人民币（**手填**，人民币付款留空）。系统不自动折算：自动算出来的数在单子上看不出错，
  /// 与「不按税率自动拆进项税」是同一条口径（见 finance-slip.ts 顶部第 2 条）。
  amountCny               Decimal?          @map("amount_cny") @db.Decimal(18, 4)
  /// 我方开户银行 / 我方银行账号（钱从我们哪个账户走）。
  ourBankName             String            @default("") @map("our_bank_name") @db.VarChar(200)
  ourBankAccount          String            @default("") @map("our_bank_account") @db.VarChar(100)
  /// 对方开户银行 / 对方银行账号（收款单位或付款单位的账户）。
  counterpartyBankName    String            @default("") @map("counterparty_bank_name") @db.VarChar(200)
  counterpartyBankAccount String            @default("") @map("counterparty_bank_account") @db.VarChar(100)
  attachmentCount         Int               @default(1) @map("attachment_count")
  remark                  String            @default("") @db.VarChar(1000)
  /// 制单人（签字栏那一格，与「谁保存的」是两件事：代录时它们不一样）。
  maker                   String            @default("") @db.VarChar(100)
  /// 预填时勾选的条目 id：付款单 = `supplier_payable_entries`，收款单 = `receivable_sources`。
  sourceEntryIds          Json?             @map("source_entry_ids")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  createdBy               String            @map("created_by") @db.Uuid
  updatedBy               String            @map("updated_by") @db.Uuid
  deletedAt               DateTime?         @map("deleted_at")
  deletedBy               String?           @map("deleted_by") @db.Uuid
  lines                   FinanceSlipLine[]

  /// 列表默认按「种类 + 日期倒序」翻页，两个条件一起用一个索引。
  @@index([kind, slipDate])
  @@map("finance_slips")
}

/// 收/付款单的一行分录（模板上那六格）。金额可空：**空 ≠ 0**。
model FinanceSlipLine {
  id             String      @id @default(uuid()) @db.Uuid
  slipId         String      @map("slip_id") @db.Uuid
  /// 行序从 1 开始（与单子上、与错误文案里的「第 N 行」同一个数）。
  lineNo         Int         @map("line_no")
  summary        String      @default("") @db.VarChar(500)
  generalSubject String      @default("") @map("general_subject") @db.VarChar(200)
  detailSubject  String      @default("") @map("detail_subject") @db.VarChar(200)
  debit          Decimal?    @db.Decimal(18, 4)
  credit         Decimal?    @db.Decimal(18, 4)
  remark         String      @default("") @db.VarChar(500)
  slip           FinanceSlip @relation(fields: [slipId], references: [id], onDelete: Cascade)

  @@unique([slipId, lineNo])
  @@map("finance_slip_lines")
}

/// 业务查询 Agent 的会话容器（V0，见 docs/design/business-query-agent-v0-module-design-2026-10-25.md）。
///
/// Agent 对业务表一律只读；这三张 agent_* 表是它唯一可写的数据，且不与业务表建外键
/// （user_id 只是逻辑引用）。所有查询必须带 userId 条件，禁止只凭 UUID 取别人的会话。
model AgentSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("agent_sessions")
}

/// 一轮问答。状态机：planning → querying → responding → completed；
/// 澄清可 planning → responding；活动状态均可到 failed/cancelled；终态不可离开。
/// 同一用户同时最多一个活动 run：应用层先查拦截，数据库的部分唯一索引是最后闸门 ——
/// 该索引 Prisma 表达不了，只落在迁移 20261025100000 里，改动必须两边同步。
model AgentRun {
  id              String   @id @default(uuid()) @db.Uuid
  sessionId       String   @map("session_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  /// 客户端幂等键。相同键且问题相同返回原 run；键相同问题不同由应用层报 409。
  clientMessageId String   @map("client_message_id") @db.VarChar(64)
  question        String   @db.Text
  /// 最终回答（由 answer_delta 事件在完成时拼接落库；活动 run 以事件流为准）。
  answer          String?  @db.Text
  /// 创建时的数据档位（full / operational）。运行中的有效档位取创建时与当前的较低者。
  accessLevel     String   @map("access_level") @db.VarChar(20)
  state           String   @db.VarChar(20)
  errorCode       String?  @map("error_code") @db.VarChar(60)
  /// 模型与工具用量（token、步骤数）。问题/答案可能含业务信息，权限与保留期按财务数据管。
  usage           Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([sessionId, clientMessageId])
  @@index([userId, state])
  @@map("agent_runs")
}

/// run 的 SSE 事件流：断线重放与刷新恢复的唯一依据。seq 由状态管理器在事务内分配，
/// 与状态变更同事务落库，所以「取消后迟到的增量」写不进终态 run。
model AgentRunEvent {
  id        String   @id @default(uuid()) @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  seq       Int
  type      String   @db.VarChar(20)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([runId, seq])
  @@map("agent_run_events")
}
