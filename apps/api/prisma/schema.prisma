model EmployeeDailyReport {
  id                         String                   @id @default(uuid()) @db.Uuid
  idempotencyKey             String?                  @unique @map("idempotency_key") @db.VarChar(200)
  version                    Int                      @default(1)
  productionOrderId          String                   @map("production_order_id") @db.Uuid
  productionOrderOperationId String                   @map("production_order_operation_id") @db.Uuid
  employeeId                 String                   @map("employee_id") @db.Uuid
  orderNo                    String                   @map("order_no") @db.VarChar(100)
  productionOrderNoSnapshot  String                   @map("production_order_no_snapshot") @db.VarChar(100)
  operationNameSnapshot      String                   @map("operation_name_snapshot") @db.VarChar(150)
  employeeNameSnapshot       String                   @map("employee_name_snapshot") @db.VarChar(100)
  reportDate                 DateTime                 @map("report_date") @db.Date
  wageMode                   String                   @map("wage_mode") @db.VarChar(20)
  quantity                   Decimal                  @db.Decimal(18, 4)
  durationMinutes            Decimal?                 @map("duration_minutes") @db.Decimal(18, 4)
  unitPrice                  Decimal                  @map("unit_price") @db.Decimal(18, 4)
  calculatedAmount           Decimal                  @map("calculated_amount") @db.Decimal(18, 4)
  priceOverrideReason        String?                  @map("price_override_reason") @db.VarChar(1000)
  remark                     String?                  @db.VarChar(1000)
  createdAt                  DateTime                 @default(now()) @map("created_at")
  updatedAt                  DateTime                 @updatedAt @map("updated_at")
  createdBy                  String                   @map("created_by") @db.Uuid
  updatedBy                  String                   @map("updated_by") @db.Uuid
  deletedAt                  DateTime?                @map("deleted_at")
  deletedBy                  String?                  @map("deleted_by") @db.Uuid
  productionOrder            ProductionOrder          @relation(fields: [productionOrderId], references: [id])
  productionOrderOperation   ProductionOrderOperation @relation(fields: [productionOrderOperationId], references: [id])
  employee                   Employee                 @relation(fields: [employeeId], references: [id])

  @@index([productionOrderId, reportDate])
  @@index([productionOrderOperationId, reportDate])
  @@index([employeeId, reportDate])
  @@index([orderNo, reportDate])
  @@map("employee_daily_reports")
}

