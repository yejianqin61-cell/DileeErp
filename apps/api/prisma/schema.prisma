  taxRate                   Decimal?                    @map("tax_rate") @db.Decimal(8, 4)
  /// 发票类型（2026-11-09 用户拍板 D5）：`special`=增值税专用发票（可抵扣，挂账时拆进项税）/
  /// `general`=增值税普通发票（不可抵扣，全额进成本）/ `none`=无票（全额进成本）。
  /// 可空 = 未录入（历史行与「确认时还没取到票」的行）：**不拆税**，台账提示待补，绝不替财务猜。
  /// `amount` 是**含税总额**，`taxRate` 是价内税率；不含税 = amount ÷ (1 + taxRate)。
  invoiceType               String?                     @map("invoice_type") @db.VarChar(20)
  amount                    Decimal                     @db.Decimal(18, 4)
  currency                  String                      @db.VarChar(10)
  confirmationDate          DateTime                    @map("confirmation_date") @db.Date
  status                    String                      @default("draft") @db.VarChar(30)
  /// 会计科目（可选，目前只有「其他应付」在建单时手选）：
  /// 备用金、房租、水电这类非采购支出**不能靠来源类型猜科目** —— 它们的来源都是 `other`，
  /// 而 `other` 的自动候选链首位是「管理费用」（损益类）。备用金实际是资产类
  /// 「库存现金（备用金）」，房租是成本类「房租费」：一条链分不开它们，只能由录单的人指。
  /// 为空 = 没指定，确认应付时仍退回按来源的候选链（历史行全部为空）。
  subjectId                 String?                     @map("subject_id") @db.Uuid
  attachment                Json                        @default("[]")
  remark                    String?                     @db.VarChar(1000)
  createdAt                 DateTime                    @default(now()) @map("created_at")
  updatedAt                 DateTime                    @updatedAt @map("updated_at")
  createdBy                 String                      @map("created_by") @db.Uuid
  updatedBy                 String                      @map("updated_by") @db.Uuid
  deletedAt                 DateTime?                   @map("deleted_at")
  deletedBy                 String?                     @map("deleted_by") @db.Uuid
  supplier                  Supplier                    @relation(fields: [supplierId], references: [id])
  /// `onDelete: Restrict` 与迁移 `20261013090000_other_payable_subject` 的 DDL 逐字一致：
  /// 科目只停用不删除（宪法《Configurable Business Categories》），被引用的科目必须留成历史快照 ——
  /// 默认的 `SetNull` 会让「删科目」把历史单据上的科目悄悄抹成空，而 Prisma 生成的迁移又会
  /// 与手写迁移永久漂移（`prisma migrate diff` 会一直报差异）。
  subject                   AccountingSubject?          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  payableSource             PayableSource?              @relation("RawMaterialPayableEntry", fields: [payableSourceId], references: [id])
  outsourcePayableSource    OutsourcePayableSource?     @relation("OutsourceSourcePayableEntry", fields: [outsourcePayableSourceId], references: [id])
  allocations               SupplierPaymentAllocation[]
  purchaseOrder             PurchaseOrder?              @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId           String?                     @map("purchase_order_id") @db.Uuid
  purchaseOrderItem         PurchaseOrderItem?          @relation(fields: [purchaseOrderItemId], references: [id])
  purchaseOrderItemId       String?                     @map("purchase_order_item_id") @db.Uuid
  outsourceLogisticsBatch   OutsourceLogisticsBatch?    @relation(fields: [outsourceLogisticsBatchId], references: [id])
  outsourceLogisticsBatchId String?                     @map("outsource_logistics_batch_id") @db.Uuid

  @@index([orderNo, status])
  @@index([supplierId, status])
  @@index([sourceType, status])
  /// 与迁移里的 `supplier_payable_entries_subject_id_idx` 对齐：会计科目是筛选维度
  /// （「这个科目下有哪些应付」），没有索引就是全表扫。不写在这里，`migrate dev` 下次会把它删掉。
  @@index([subjectId])
  @@map("supplier_payable_entries")
}

