/// 成品出库通知：成品入库后由销售发起「通知仓库发货（寄给客户）」。
/// 一张通知对应一个生产单的一批可出库量；仓库可以**分多次**生成出库单直到发完，
/// 出库过账后自动生成应收来源草稿（通知财务收款），全部发完时通知置为 completed。
model FinishedGoodsOutboundNotice {
  id                           String                   @id @default(uuid()) @db.Uuid
  noticeNo                     String                   @unique @map("notice_no") @db.VarChar(100)
  orderNo                      String                   @map("order_no") @db.VarChar(100)
  salesOrderId                 String                   @map("sales_order_id") @db.Uuid
  productionOrderId            String                   @map("production_order_id") @db.Uuid
  customerId                   String                   @map("customer_id") @db.Uuid
  productNameSnapshot          String?                  @map("product_name_snapshot") @db.VarChar(200)
  productSpecificationSnapshot String?                  @map("product_specification_snapshot") @db.VarChar(1000)
  unitId                       String                   @map("unit_id") @db.Uuid
  unitNameSnapshot             String?                  @map("unit_name_snapshot") @db.VarChar(30)
  /// 通知时的成品已入库量 / 已出库量快照，便于事后追溯「为什么只通知了这么多」。
  inboundQuantity              Decimal                  @map("inbound_quantity") @db.Decimal(18, 4)
  outboundQuantity             Decimal                  @map("outbound_quantity") @db.Decimal(18, 4)
  noticeQuantity               Decimal                  @map("notice_quantity") @db.Decimal(18, 4)
