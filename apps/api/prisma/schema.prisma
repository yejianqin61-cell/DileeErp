  inventoryFacts               InventoryFact[]
  receivableSource             ReceivableSource?
  // 一张出库通知可以分多次出库（`finished_goods_outbounds.outbound_notice_id` 挂在出库单上）。
  outboundNoticeId             String?                      @map("outbound_notice_id") @db.Uuid
  outboundNotice               FinishedGoodsOutboundNotice? @relation(fields: [outboundNoticeId], references: [id])

  @@index([orderNo, status])
  @@index([salesOrderId, status])
  @@index([productionOrderId, status])
  @@index([outboundNoticeId])
  @@map("finished_goods_outbounds")
}

/// 成品出库通知：成品入库后由销售发起「通知仓库发货（寄给客户）」。
/// 一张通知对应一个生产单的一批可出库量；仓库可以**分多次**生成出库单直到发完，
/// 出库过账后自动生成应收来源草稿（通知财务收款），全部发完时通知置为 completed。
model FinishedGoodsOutboundNotice {
  id                           String                  @id @default(uuid()) @db.Uuid
  noticeNo                     String                  @unique @map("notice_no") @db.VarChar(100)
  orderNo                      String                  @map("order_no") @db.VarChar(100)
  salesOrderId                 String                  @map("sales_order_id") @db.Uuid
  productionOrderId            String                  @map("production_order_id") @db.Uuid
  customerId                   String                  @map("customer_id") @db.Uuid
  productNameSnapshot          String?                 @map("product_name_snapshot") @db.VarChar(200)
  productSpecificationSnapshot String?                 @map("product_specification_snapshot") @db.VarChar(1000)
  unitId                       String                  @map("unit_id") @db.Uuid
  unitNameSnapshot             String?                 @map("unit_name_snapshot") @db.VarChar(30)
  /// 通知时的成品已入库量 / 已出库量快照，便于事后追溯「为什么只通知了这么多」。
  inboundQuantity              Decimal                 @map("inbound_quantity") @db.Decimal(18, 4)
  outboundQuantity             Decimal                 @map("outbound_quantity") @db.Decimal(18, 4)
  noticeQuantity               Decimal                 @map("notice_quantity") @db.Decimal(18, 4)
  /// 该通知已过账出库的累计数量（分批出库时逐步累加；仓库侧据此算剩余可出库量）。
  shippedQuantity              Decimal                 @default(0) @map("shipped_quantity") @db.Decimal(18, 4)
  /// pending（待建单）/ outbound_created（有草稿待过账）/ partially_outbound（已部分出库）/
  /// completed（通知量已全部出库）/ cancelled
  status                       String                  @default("pending") @db.VarChar(30)
  notifiedAt                   DateTime                @default(now()) @map("notified_at")
  notifiedBy                   String                  @map("notified_by") @db.Uuid
  remark                       String?                 @db.VarChar(1000)
  version                      Int                     @default(1)
  idempotencyKey               String                  @unique @map("idempotency_key") @db.VarChar(200)
  createdAt                    DateTime                @default(now()) @map("created_at")
  updatedAt                    DateTime                @updatedAt @map("updated_at")
  createdBy                    String                  @map("created_by") @db.Uuid
  updatedBy                    String                  @map("updated_by") @db.Uuid
  deletedAt                    DateTime?               @map("deleted_at")
  deletedBy                    String?                 @map("deleted_by") @db.Uuid
  salesOrder                   SalesOrder              @relation(fields: [salesOrderId], references: [id])
  productionOrder              ProductionOrder         @relation(fields: [productionOrderId], references: [id])
  unit                         Unit                    @relation(fields: [unitId], references: [id])
  outbounds                    FinishedGoodsOutbound[]

  @@index([orderNo, status])
  @@index([salesOrderId, status])
  @@index([productionOrderId, status])
  @@map("finished_goods_outbound_notices")
}

