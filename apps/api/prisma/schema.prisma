model Bank {
  id            String              @id @default(uuid()) @db.Uuid
  bankCode      String              @unique @map("bank_code") @db.VarChar(80)
  bankName      String              @map("bank_name") @db.VarChar(200)
  accountName   String              @map("account_name") @db.VarChar(200)
  accountNumber String              @map("account_number") @db.VarChar(100)
  currency      String              @db.VarChar(10)
  /// 建账期初余额：系统余额 = 期初余额 + 生效收支流水 + 互转净额（见 docs/design/bank-balance-and-transfer-2026-09-16.md）。
  /// 单独一列而不是从流水倒推：财务接手的账户本来就有余额，没有期初就永远对不上银行对账单。
  openingBalance Decimal            @default(0) @map("opening_balance") @db.Decimal(18, 4)
  isActive      Boolean             @default(true) @map("is_active")
  swiftCode     String?             @map("swift_code") @db.VarChar(50)
  remark        String?             @db.VarChar(1000)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  createdBy     String              @map("created_by") @db.Uuid
  updatedBy     String              @map("updated_by") @db.Uuid
  deletedAt     DateTime?           @map("deleted_at")
  deletedBy     String?             @map("deleted_by") @db.Uuid
  payableReconciliations SupplierPayableReconciliation[]
  supplierPayments       SupplierPayment[]
  customerPayments       CustomerPayment[]
  salaryPayments         SalaryPayment[]
  receivableReconciliations ReceivableReconciliation[]
  cashFlowEntries        CashFlowEntry[]
  transfersOut           BankTransfer[] @relation("BankTransferFrom")
  transfersIn            BankTransfer[] @relation("BankTransferTo")
  voucherLines           VoucherLine[]

  @@map("banks")
}

/// 银行余额互转：同一个银行池内两个账户之间的资金划转（含跨币种）。
///
/// 为什么不写成两条 CashFlowEntry：互转既不是收入也不是支出，记成「A 支出 + B 收入」会让
/// 收支汇总表凭空多出一笔收入与一笔支出（收支口径被污染）。资金确实动了，但它动在银行账户之间，
/// 因此单独一张表，只在计算**银行余额**时参与：转出方 −fromAmount、转入方 +toAmount。
/// 收支明细表因此不出现互转行 —— 这是有意的口径，不是遗漏。
model BankTransfer {
  id             String   @id @default(uuid()) @db.Uuid
  transferNo     String   @unique @map("transfer_no") @db.VarChar(100)
  transferDate   DateTime @map("transfer_date") @db.Date
  fromBankId     String   @map("from_bank_id") @db.Uuid
  /// 本方币种：默认取账户币种，但允许与账户币种不同（多币种户要能指定实际扣的币种）。
  fromCurrency   String   @map("from_currency") @db.VarChar(10)
  toBankId       String   @map("to_bank_id") @db.Uuid
  toCurrency     String   @map("to_currency") @db.VarChar(10)
  fromAmount     Decimal  @map("from_amount") @db.Decimal(18, 4)
  /// 对方金额：跨币种时由财务填实际到账数；同币种时必须与 fromAmount 相等（否则是凭空多钱或少钱）。
  toAmount       Decimal  @map("to_amount") @db.Decimal(18, 4)
  /// 汇率快照（toAmount / fromAmount）：同币种为 1。存下来是为了事后能解释「当时按什么价换的」。
  exchangeRate   Decimal? @map("exchange_rate") @db.Decimal(18, 6)
  /// posted（生效）/ reversed（已冲销，保留行但不再计入余额）
  status         String   @default("posted") @db.VarChar(30)
  reversalReason String?  @map("reversal_reason") @db.VarChar(500)
  remark         String?  @map("remark") @db.VarChar(1000)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String   @map("created_by") @db.Uuid
  updatedBy      String   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?  @map("deleted_by") @db.Uuid
  fromBank       Bank     @relation("BankTransferFrom", fields: [fromBankId], references: [id])
  toBank         Bank     @relation("BankTransferTo", fields: [toBankId], references: [id])

  @@index([transferDate, status])
  @@index([fromBankId, status])
  @@index([toBankId, status])
  @@map("bank_transfers")
}

/// 库存盘点单（仓库，用户 2026-09-16：「仓库模块增加一个盘点管理，可以将每月一次的盘点数据
/// 导入系统，调整库存物料数量。物料的产品代码作为唯一性」）。
///
/// 与已确认的盘点口径一致（docs/design/warehouse-module-design.md §6，集中待确认事项 28）：
/// **盘点不直接改库存余额**，确认时按行生成独立的库存调整事实（inventory_facts），并留下审计。
/// 于是「导入」只建一张草稿单：确认前随时可改可删（草稿不是业务事实），确认后只能冲销。
model Stocktake {
  id             String    @id @default(uuid()) @db.Uuid
  stocktakeNo    String    @unique @map("stocktake_no") @db.VarChar(100)
  /// 盘点月份 YYYY-MM。用户口径是「每月一次」，按月份归档才能和纸质盘点表对上。
  periodMonth    String    @map("period_month") @db.VarChar(7)
  /// draft（草稿：可改可删）| confirmed（已确认：已写库存调整）| reversed（已冲销）
  status         String    @default("draft") @db.VarChar(30)
  /// 导入来源文件名。盘点表是外部 Excel，事后必须能说清这张单子从哪个文件来。
  sourceFileName String?   @map("source_file_name") @db.VarChar(300)
  importedAt     DateTime? @map("imported_at")
  confirmedAt    DateTime? @map("confirmed_at")
  confirmedBy    String?   @map("confirmed_by") @db.Uuid
  reversedAt     DateTime? @map("reversed_at")
  reversedBy     String?   @map("reversed_by") @db.Uuid
  reversalReason String?   @map("reversal_reason") @db.VarChar(1000)
  remark         String?   @db.VarChar(1000)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String    @map("created_by") @db.Uuid
  updatedBy      String    @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by") @db.Uuid
  lines          StocktakeLine[]

  @@index([periodMonth, status])
  @@map("stocktakes")
}

/// 盘点明细行。一行 = 盘点表里的一行（产品代码 + 仓位 + 货位 + 实盘数）。
///
/// 三个数量快照必须分开存，否则事后解释不清「为什么差异和我导进来时看到的不一样」：
///   - `bookQuantitySnapshot`：**导入时**的账面数，操作员当时看到的数，只作展示；
///   - `bookQuantityAtConfirm`：**确认时**的账面数，真正参与计算的那个数；
///   - `appliedQuantity`：确认时实际写进库存事实的差额（= 实盘数 − 确认时账面数）。
/// 导入与确认之间仓库可能又发生了领料/入库；按确认时账面重算，才不会把那些真实收发悄悄冲掉
/// （用户 2026-09-16 已确认这一条）。
///
/// `warehouseZone` / `binLocation` 是**文本记录**，不是库位维度：V1 已确认不建库位主数据
/// （集中待确认事项 1），这里原样收下是为了能和纸质盘点表逐行对照、找货。
/// 同一产品代码出现在多个仓位时按物料合并后再与账面比（见 stocktake-import.ts 的口径）。
model StocktakeLine {
  id                    String   @id @default(uuid()) @db.Uuid
  stocktakeId           String   @map("stocktake_id") @db.Uuid
  /// 盘点表内的行号（1 起，按文件顺序）：报错与对表都用它。
  lineNo                Int      @map("line_no")
  materialId            String   @map("material_id") @db.Uuid
  /// 产品代码 = 物料编码（用户 2026-09-16 确认两者是同一个字段）。存快照是为了物料改名/改码后
  /// 还能还原「当时盘的是哪一行」。
  productCodeSnapshot   String   @map("product_code_snapshot") @db.VarChar(80)
  productNameSnapshot   String   @map("product_name_snapshot") @db.VarChar(200)
  specificationSnapshot String?  @map("specification_snapshot") @db.VarChar(200)
  warehouseZone         String?  @map("warehouse_zone") @db.VarChar(100)
  binLocation           String?  @map("bin_location") @db.VarChar(100)
  /// 盘点单位固定取物料的默认单位：跨单位相加没有意义，V1 也不做单位换算（集中待确认事项 4）。
  unitId                String   @map("unit_id") @db.Uuid
  /// 实盘数：允许 0（整箱盘没了就是 0，这正是盘亏要记的事），不允许负数。
  actualQuantity        Decimal  @map("actual_quantity") @db.Decimal(18, 4)
  bookQuantitySnapshot  Decimal  @map("book_quantity_snapshot") @db.Decimal(18, 4)
  differenceSnapshot    Decimal  @map("difference_snapshot") @db.Decimal(18, 4)
  bookQuantityAtConfirm Decimal? @map("book_quantity_at_confirm") @db.Decimal(18, 4)
  appliedQuantity       Decimal? @map("applied_quantity") @db.Decimal(18, 4)
  differenceReason      String?  @map("difference_reason") @db.VarChar(1000)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  createdBy             String   @map("created_by") @db.Uuid
  updatedBy             String   @map("updated_by") @db.Uuid
  stocktake             Stocktake @relation(fields: [stocktakeId], references: [id])
  material              Material  @relation(fields: [materialId], references: [id])
  unit                  Unit      @relation(fields: [unitId], references: [id])
  inventoryFacts        InventoryFact[]

  @@unique([stocktakeId, lineNo])
  @@index([materialId])
  @@index([stocktakeId])
  @@map("stocktake_lines")
}