generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique @db.VarChar(100)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  displayName  String     @map("display_name") @db.VarChar(100)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdBy    String     @map("created_by") @db.Uuid
  updatedBy    String     @map("updated_by") @db.Uuid
  deletedAt    DateTime?  @map("deleted_at")
  deletedBy    String?    @map("deleted_by") @db.Uuid
  roles        UserRole[]
  sessions     Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(128)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String   @map("created_by") @db.Uuid
  updatedBy String   @map("updated_by") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(80)
  name        String           @db.VarChar(100)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  createdBy   String           @map("created_by") @db.Uuid
  updatedBy   String           @map("updated_by") @db.Uuid
  deletedAt   DateTime?        @map("deleted_at")
  deletedBy   String?          @map("deleted_by") @db.Uuid
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleKey   String   @map("role_key") @db.VarChar(80)
  moduleKey String   @map("module_key") @db.VarChar(80)
  role      Role     @relation(fields: [roleKey], references: [key])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String   @map("created_by") @db.Uuid
  updatedBy String   @map("updated_by") @db.Uuid

  @@id([roleKey, moduleKey])
  @@map("role_permissions")
}

model DictionaryType {
  id        String           @id @default(uuid()) @db.Uuid
  key       String           @unique @db.VarChar(80)
  name      String           @db.VarChar(100)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  createdBy String           @map("created_by") @db.Uuid
  updatedBy String           @map("updated_by") @db.Uuid
  deletedAt DateTime?        @map("deleted_at")
  deletedBy String?          @map("deleted_by") @db.Uuid
  items     DictionaryItem[]

  @@map("dictionary_types")
}

model DictionaryItem {
  id               String          @id @default(uuid()) @db.Uuid
  typeId           String          @map("type_id") @db.Uuid
  key              String          @db.VarChar(80)
  label            String          @db.VarChar(100)
  sortOrder        Int             @default(0) @map("sort_order")
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  createdBy        String          @map("created_by") @db.Uuid
  updatedBy        String          @map("updated_by") @db.Uuid
  deletedAt        DateTime?       @map("deleted_at")
  deletedBy        String?         @map("deleted_by") @db.Uuid
  type             DictionaryType  @relation(fields: [typeId], references: [id])
  cashFlowAccounts CashFlowEntry[] @relation("CashFlowAccount")

  @@unique([typeId, key])
  @@map("dictionary_items")
}

model StateDefinition {
  id              String            @id @default(uuid()) @db.Uuid
  machineKey      String            @map("machine_key") @db.VarChar(80)
  key             String            @db.VarChar(80)
  label           String            @db.VarChar(100)
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  createdBy       String            @map("created_by") @db.Uuid
  updatedBy       String            @map("updated_by") @db.Uuid
  deletedAt       DateTime?         @map("deleted_at")
  deletedBy       String?           @map("deleted_by") @db.Uuid
  fromTransitions StateTransition[] @relation("from_state")
  toTransitions   StateTransition[] @relation("to_state")
  stateRecords    StateRecord[]

  @@unique([machineKey, key])
  @@map("state_definitions")
}

model StateRecord {
  id             String          @id @default(uuid()) @db.Uuid
  machineKey     String          @map("machine_key") @db.VarChar(80)
  entityType     String          @map("entity_type") @db.VarChar(80)
  entityId       String          @map("entity_id") @db.Uuid
  currentStateId String          @map("current_state_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  createdBy      String          @map("created_by") @db.Uuid
  updatedBy      String          @map("updated_by") @db.Uuid
  currentState   StateDefinition @relation(fields: [currentStateId], references: [id])
  changes        StateChange[]

  @@unique([machineKey, entityType, entityId])
  @@map("state_records")
}

model StateChange {
  id          String      @id @default(uuid()) @db.Uuid
  recordId    String      @map("record_id") @db.Uuid
  fromStateId String?     @map("from_state_id") @db.Uuid
  toStateId   String      @map("to_state_id") @db.Uuid
  remark      String?     @db.VarChar(500)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  createdBy   String      @map("created_by") @db.Uuid
  updatedBy   String      @map("updated_by") @db.Uuid
  record      StateRecord @relation(fields: [recordId], references: [id])

  @@index([recordId, createdAt])
  @@map("state_changes")
}

model StateTransition {
  id          String          @id @default(uuid()) @db.Uuid
  machineKey  String          @map("machine_key") @db.VarChar(80)
  fromStateId String          @map("from_state_id") @db.Uuid
  toStateId   String          @map("to_state_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  createdBy   String          @map("created_by") @db.Uuid
  updatedBy   String          @map("updated_by") @db.Uuid
  fromState   StateDefinition @relation("from_state", fields: [fromStateId], references: [id])
  toState     StateDefinition @relation("to_state", fields: [toStateId], references: [id])

  @@unique([machineKey, fromStateId, toStateId])
  @@map("state_transitions")
}

model Attachment {
  id         String           @id @default(uuid()) @db.Uuid
  fileName   String           @map("file_name") @db.VarChar(255)
  storageKey String           @unique @map("storage_key") @db.VarChar(500)
  mimeType   String           @map("mime_type") @db.VarChar(150)
  fileSize   BigInt           @map("file_size")
  sha256     String           @db.Char(64)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  createdBy  String           @map("created_by") @db.Uuid
  updatedBy  String           @map("updated_by") @db.Uuid
  deletedAt  DateTime?        @map("deleted_at")
  deletedBy  String?          @map("deleted_by") @db.Uuid
  links      AttachmentLink[]

  @@map("attachments")
}

model AttachmentLink {
  id           String     @id @default(uuid()) @db.Uuid
  attachmentId String     @map("attachment_id") @db.Uuid
  entityType   String     @map("entity_type") @db.VarChar(80)
  entityId     String     @map("entity_id") @db.Uuid
  remark       String?    @db.VarChar(500)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdBy    String     @map("created_by") @db.Uuid
  updatedBy    String     @map("updated_by") @db.Uuid
  attachment   Attachment @relation(fields: [attachmentId], references: [id])

  @@index([entityType, entityId])
  @@map("attachment_links")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  orderNo    String?  @map("order_no") @db.VarChar(100)
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_events")
}

model Customer {
  id                        String                     @id @default(uuid()) @db.Uuid
  customerCode              String                     @unique @map("customer_code") @db.VarChar(80)
  name                      String                     @unique @db.VarChar(200)
  countryRegion             String?                    @map("country_region") @db.VarChar(100)
  address                   String?                    @db.VarChar(500)
  paymentTerms              String?                    @map("payment_terms") @db.VarChar(200)
  currency                  String?                    @db.VarChar(10)
  remark                    String?                    @db.VarChar(1000)
  isActive                  Boolean                    @default(true) @map("is_active")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  createdBy                 String                     @map("created_by") @db.Uuid
  updatedBy                 String                     @map("updated_by") @db.Uuid
  deletedAt                 DateTime?                  @map("deleted_at")
  deletedBy                 String?                    @map("deleted_by") @db.Uuid
  contacts                  CustomerContact[]
  salesOrders               SalesOrder[]
  receivableSources         ReceivableSource[]
  customerPayments          CustomerPayment[]
  receivableAdjustments     ReceivableAdjustment[]
  receivableReconciliations ReceivableReconciliation[]

  @@map("customers")
}

model CustomerContact {
  id          String       @id @default(uuid()) @db.Uuid
  customerId  String       @map("customer_id") @db.Uuid
  name        String       @db.VarChar(100)
  position    String?      @db.VarChar(100)
  phone       String?      @db.VarChar(50)
  email       String?      @db.VarChar(200)
  isDefault   Boolean      @default(false) @map("is_default")
  remark      String?      @db.VarChar(500)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  createdBy   String       @map("created_by") @db.Uuid
  updatedBy   String       @map("updated_by") @db.Uuid
  deletedAt   DateTime?    @map("deleted_at")
  deletedBy   String?      @map("deleted_by") @db.Uuid
  customer    Customer     @relation(fields: [customerId], references: [id])
  salesOrders SalesOrder[]

  @@index([customerId, isActive])
  @@map("customer_contacts")
}

model SalesOrder {
  id                           String                        @id @default(uuid()) @db.Uuid
  /// 订单号在**未删除的行**上唯一：部分唯一索引
  /// `sales_orders_order_no_active_key ... WHERE deleted_at IS NULL`（见迁移
  /// `20261008100000_sales_order_no_active_unique`）。这里**刻意不写 `@unique`** ——
  /// `@unique` 生成的是全量唯一索引，会让「软删一张号写错的草稿之后，再用同一个号重新建单」
  /// 这条最顺手的路走不通（用户 2026-10-08 拍板要能走通）。照抄 `boms` / `purchase_plans` 的先例。
  orderNo                      String                        @map("order_no") @db.VarChar(100)
  customerId                   String                        @map("customer_id") @db.Uuid
  contactId                    String?                       @map("contact_id") @db.Uuid
  customerSnapshot             Json                          @map("customer_snapshot")
  contactSnapshot              Json?                         @map("contact_snapshot")
  customerPoNo                 String?                       @map("customer_po_no") @db.VarChar(100)
  externalContractNo           String?                       @map("external_contract_no") @db.VarChar(100)
  orderDate                    DateTime                      @map("order_date")
  productName                  String                        @map("product_name") @db.VarChar(200)
  productSpec                  String?                       @map("product_spec") @db.VarChar(1000)
  quantity                     Decimal                       @db.Decimal(18, 4)
  unit                         String                        @db.VarChar(30)
  deliveryDate                 DateTime?                     @map("delivery_date")
  currency                     String                        @db.VarChar(10)
  unitPrice                    Decimal?                      @map("unit_price") @db.Decimal(18, 4)
  totalAmount                  Decimal?                      @map("total_amount") @db.Decimal(18, 4)
  taxRate                      Decimal?                      @map("tax_rate") @db.Decimal(8, 4)
  // 结算口径（销售手工填写）：结算币价=按结算币种计价的单价；应收金额=本单应收总额；
  // 结算方式=tt/letter_of_credit/cash/monthly/other；本币金额=折算成人民币的金额。
  // 成品出库过账生成应收来源时优先取结算币价，其次取销售单价。
  settlementUnitPrice          Decimal?                      @map("settlement_unit_price") @db.Decimal(18, 4)
  receivableAmount             Decimal?                      @map("receivable_amount") @db.Decimal(18, 4)
  settlementMethod             String?                       @map("settlement_method") @db.VarChar(30)
  localCurrencyAmount          Decimal?                      @map("local_currency_amount") @db.Decimal(18, 4)
  // ---- 货号与返单（2026-09-26，老板要求）----
  // 订单级一个货号：客户返单时货号不变，按它把历次批次归到一组。
  // 设计见 docs/design/reorder-item-no-and-summary-2026-09-26.md。
  //   1. **不建主数据表**：货号清单是销售单的投影（GROUP BY），不另立一份会漂移的真源。
  //   2. **不冗余到下游表**：采购/生产/QC 已经冗余了 order_no，再冗余货号就有两个真源 ——
  //      改一次货号要改 N 张表，漏一张就出现「同一批货两种拼写」。查询走
  //      「货号 → 订单号集合 → 下游 by orderNo」，正好吃既有的 orderNo 索引。
  //   3. **可空**：历史单没有货号，加 NOT NULL 会让迁移在真实库上直接失败；
  //      补录待办在【返单与总结 → 未填货号】里。
  itemNo                       String?                       @map("item_no") @db.VarChar(100)
  /**
   * 返单来源销售单号。存文本而非自引用外键：订单号本身唯一，而返单链不该因老单被删/改而断裂。
   */
  reorderFromOrderNo           String?                       @map("reorder_from_order_no") @db.VarChar(100)
  status                       String                        @default("draft") @db.VarChar(30)
  currentVersion               Int                           @default(1) @map("current_version")
  extensionData                Json                          @default("{}") @map("extension_data")
  // ---- 下单口径细化（2026-09-16，按 example/销售单 的工艺单模板）----
  // 模板里「材料明细 / 工艺要求 / 布量 / 正唛侧唛 / 注意事项」是**固定栏位**（用户拍板：
  // 按两张样本的并集做成固定字段），所以直接落列而不是塞 extension_data(JSON)：
  // 这些字要在页面上逐格编辑、要按模板逐格打印、还要能被审计，JSON 三样都做不到。
  factory                      String?                       @map("factory") @db.VarChar(100)
  completionRemark             String?                       @map("completion_remark") @db.VarChar(100)
  attentionNote                String?                       @map("attention_note") @db.VarChar(2000)
  shippingMarkFront            String?                       @map("shipping_mark_front") @db.VarChar(2000)
  shippingMarkSide             String?                       @map("shipping_mark_side") @db.VarChar(2000)
  // 布量（模板「伞面/伞带/木耳/天布/布套（Y/DZ)」五个数值格）
  fabricUsageCanopy            Decimal?                      @map("fabric_usage_canopy") @db.Decimal(18, 4)
  fabricUsageStrap             Decimal?                      @map("fabric_usage_strap") @db.Decimal(18, 4)
  fabricUsageWoodEar           Decimal?                      @map("fabric_usage_wood_ear") @db.Decimal(18, 4)
  fabricUsageTop               Decimal?                      @map("fabric_usage_top") @db.Decimal(18, 4)
  fabricUsageBag               Decimal?                      @map("fabric_usage_bag") @db.Decimal(18, 4)
  // 材料明细（两样本并集 18 项；样本1 有伞头带/伞带粘扣/织标，样本2 有天布/木耳/钥匙扣/印刷）
  ribSpec                      String?                       @map("rib_spec") @db.VarChar(1000)
  canopySpec                   String?                       @map("canopy_spec") @db.VarChar(1000)
  handleSpec                   String?                       @map("handle_spec") @db.VarChar(1000)
  handleStrapSpec              String?                       @map("handle_strap_spec") @db.VarChar(1000)
  tailSpec                     String?                       @map("tail_spec") @db.VarChar(1000)
  runnerSpec                   String?                       @map("runner_spec") @db.VarChar(1000)
  strapSpec                    String?                       @map("strap_spec") @db.VarChar(1000)
  strapFastenerSpec            String?                       @map("strap_fastener_spec") @db.VarChar(1000)
  innerLabelSpec               String?                       @map("inner_label_spec") @db.VarChar(1000)
  wovenLabelSpec               String?                       @map("woven_label_spec") @db.VarChar(1000)
  hangTagSpec                  String?                       @map("hang_tag_spec") @db.VarChar(1000)
  oppSpec                      String?                       @map("opp_spec") @db.VarChar(1000)
  bagSpec                      String?                       @map("bag_spec") @db.VarChar(1000)
  packagingSpec                String?                       @map("packaging_spec") @db.VarChar(1000)
  topFabricSpec                String?                       @map("top_fabric_spec") @db.VarChar(1000)
  woodEarSpec                  String?                       @map("wood_ear_spec") @db.VarChar(1000)
  keychainSpec                 String?                       @map("keychain_spec") @db.VarChar(1000)
  printingSpec                 String?                       @map("printing_spec") @db.VarChar(1000)
  // 工艺要求（两样本并集 9 项；导出时按有值的条目重新编号）
  sampleRequirement            String?                       @map("sample_requirement") @db.VarChar(1000)
  cuttingRequirement           String?                       @map("cutting_requirement") @db.VarChar(1000)
  edgeRequirement              String?                       @map("edge_requirement") @db.VarChar(1000)
  joiningRequirement           String?                       @map("joining_requirement") @db.VarChar(1000)
  topStitchRequirement         String?                       @map("top_stitch_requirement") @db.VarChar(1000)
  sewingRequirement            String?                       @map("sewing_requirement") @db.VarChar(1000)
  strapRequirement             String?                       @map("strap_requirement") @db.VarChar(1000)
  hangTagNote                  String?                       @map("hang_tag_note") @db.VarChar(1000)
  qcRequirement                String?                       @map("qc_requirement") @db.VarChar(1000)
  // ---- 细分明细的自定义列名（2026-09-30，用户要求）----
  // 「细分明细那边，可以改成自定义字段名称」：明细表那 6 个列名（分组名 / 品番品名 / 颜色配色 /
  // 条码 / 数量 / 单位）**按单**改成用户自己的叫法，导出件跟着这张单印。
  // 为什么是 JSON 而不是 6 个列：这是一组"可有可无的显示名"，没有任何一条业务规则挂在上面
  // （既不参与校验、也不参与计算），为它加 6 列会让这行再宽 6 格，而默认值就在代码里
  // （`SPEC_DETAIL_LABELS`）。空对象 `{}` = 全部用默认列名。
  // 为什么不做成"用字典维护、全站一份"：同一张单的不同分组列名本来就不同（模板样本里
  // 「伞布明细」与「伞头配色」两块的表头就不一样），而用户要的是"这一单按我写的印"。
  specDetailLabels             Json                          @default("{}") @map("spec_detail_labels")
  createdAt                    DateTime                      @default(now()) @map("created_at")
  updatedAt                    DateTime                      @updatedAt @map("updated_at")
  createdBy                    String                        @map("created_by") @db.Uuid
  updatedBy                    String                        @map("updated_by") @db.Uuid
  deletedAt                    DateTime?                     @map("deleted_at")
  deletedBy                    String?                       @map("deleted_by") @db.Uuid
  customer                     Customer                      @relation(fields: [customerId], references: [id])
  contact                      CustomerContact?              @relation(fields: [contactId], references: [id])
  versions                     SalesOrderVersion[]
  boms                         Bom[]
  purchaseOrders               PurchaseOrder[]
  purchasePlans                PurchasePlan[]
  productionOrders             ProductionOrder[]
  finishedGoodsOutbounds       FinishedGoodsOutbound[]
  finishedGoodsOutboundNotices FinishedGoodsOutboundNotice[]
  customerReturns              CustomerReturn[]
  receivableSources            ReceivableSource[]
  customerPayments             CustomerPayment[]
  receivableAdjustments        ReceivableAdjustment[]
  receivableReconciliations    ReceivableReconciliation[]
  specDetails                  SalesOrderSpecDetail[]
  materialRefs                 SalesOrderMaterialRef[]
  materialExtras               SalesOrderMaterialExtra[]
  /// 销售单行图片（2026-11-04）：材料格与明细行的「每种一张图」都从这张库里挑。
  images                       SalesOrderImage[]
  /// 18 个材料类目各自的直接图片（与物料引用无关的一格一图映射）。
  slotImages                   SalesOrderSlotImage[]

  purchaseReceipts                   PurchaseReceipt[]
  incomingInspections                IncomingInspection[]
  rawMaterialInboundNotices          RawMaterialInboundNotice[]
  rawMaterialInbounds                RawMaterialInbound[]
  payableSources                     PayableSource[]
  outsourceLogisticsBatches          OutsourceLogisticsBatch[]
  outsourceReceipts                  OutsourceReceipt[]
  outsourcePayableSources            OutsourcePayableSource[]
  outsourceReturnTransfers           OutsourceReturnTransfer[]
  outsourceDirectShipments           OutsourceDirectShipment[]
  rawMaterialMovements               RawMaterialMovement[]
  operationDailyReports              OperationDailyReport[]
  employeeDailyReports               EmployeeDailyReport[]
  productionDailyAlerts              ProductionDailyAlert[]
  productionPayrollSources           ProductionPayrollSource[]
  inventoryFacts                     InventoryFact[]
  finishedGoodsInspectionSubmissions FinishedGoodsInspectionSubmission[]
  finishedGoodsQcRecords             FinishedGoodsQcRecord[]
  finishedGoodsInboundNotices        FinishedGoodsInboundNotice[]
  finishedGoodsInbounds              FinishedGoodsInbound[]
  finishedGoodsDefectives            FinishedGoodsDefective[]
  supplierPayableEntries             SupplierPayableEntry[]
  supplierPayments                   SupplierPayment[]
  supplierPaymentAllocations         SupplierPaymentAllocation[]
  supplierPayableReconciliations     SupplierPayableReconciliation[]
  cashFlowEntries                    CashFlowEntry[]
  payrollPayableEntries              PayrollPayableEntry[]

  @@index([customerId, status])
  @@index([orderDate])
  /// 货号清单要按 (货号, 下单日期) 取数（reorder 模块的 articles 聚合）。
  @@index([itemNo, orderDate])
  /// 订单号反查（按号取单、返单来源、改号占用预检都走它）。
  /// 与部分唯一索引并存：schema 声明普通索引，SQL 里另建 partial unique（照抄 `boms` / `purchase_plans`）——
  /// 部分索引只覆盖带 `deleted_at IS NULL` 的查询，别的入口（不带该条件的反查）还得靠这条普通索引。
  @@index([orderNo])
  @@map("sales_orders")
}

/**
 * 销售单「细分明细」行（2026-09-16 下单口径细化）。
 * 一张通用表用 `groupName` 区分用途：样本1 的「伞布明细」（品番/品名 + 颜色 + 数量）、
 * 样本2 的「伞头配色」（伞头名 + 配色 + 条码 + 数量/打）与「外层花色搭配」都是同一种形状。
 * 用户拍板「一张通用表 + 分组名」，所以不为每种明细表各建一张（否则出现第三种又要加表）。
 * **每行最多挂 3 张图**（2026-11-04 首版每行 1 张；2026-11-05 用户：「销售单那边，一条物料支持导入
 * 3 张图片，现在只有 1 张」→ 三个位置：`image_id` 第 1 张、`image_id_2` 第 2 张、`image_id_3` 第 3 张，
 * 空 = 没有那一张，允许只填前两张）。
 * 图片本身是**独立上传的库行**（`SalesOrderImage`），这里只存 `imageId` 指针：因为本表的替换语义是
 * 「软删旧的 + 建新的」（行 id 每次保存都会变），把字节挂在这一行上会在每次保存时丢掉/重复。
 */
model SalesOrderSpecDetail {
  id           String           @id @default(uuid()) @db.Uuid
  salesOrderId String           @map("sales_order_id") @db.Uuid
  /**
   * 分组名：伞布明细 / 伞头配色 / 外层花色搭配 …（导出时同组的行落在同一块）
   */
  groupName    String           @map("group_name") @db.VarChar(100)
  /**
   * 品番/品名（「27621 流水花扇PKGY」）或伞头英文名（「Hawái」）
   */
  name         String           @db.VarChar(200)
  /**
   * 颜色 / 配色（样本1「PKGY」；样本2「配色按图片」）
   */
  color        String?          @db.VarChar(100)
  /**
   * 条码（样本2「内标、吊牌、纸箱：条形码」列）
   */
  barcode      String?          @db.VarChar(100)
  quantity     Decimal?         @db.Decimal(18, 4)
  unit         String?          @db.VarChar(30)
  /**
   * 这一行挂的第 1 张图（`sales_order_images` 的 id）。空 = 这一行没有图。
   */
  imageId      String?          @map("image_id") @db.Uuid
  /**
   * 第 2 张图（2026-11-05「一条物料最多 3 张」）。空 = 只挂了 1 张（或 0 张）。
   */
  imageId2     String?          @map("image_id_2") @db.Uuid
  /**
   * 第 3 张图。空 = 没挂满 3 张。
   */
  imageId3     String?          @map("image_id_3") @db.Uuid
  sortOrder    Int              @default(0) @map("sort_order")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  createdBy    String           @map("created_by") @db.Uuid
  updatedBy    String           @map("updated_by") @db.Uuid
  deletedAt    DateTime?        @map("deleted_at")
  deletedBy    String?          @map("deleted_by") @db.Uuid
  salesOrder   SalesOrder       @relation(fields: [salesOrderId], references: [id])
  image        SalesOrderImage? @relation("sales_order_spec_detail_image_1", fields: [imageId], references: [id], onDelete: SetNull)
  image2       SalesOrderImage? @relation("sales_order_spec_detail_image_2", fields: [imageId2], references: [id], onDelete: SetNull)
  image3       SalesOrderImage? @relation("sales_order_spec_detail_image_3", fields: [imageId3], references: [id], onDelete: SetNull)

  @@index([salesOrderId, sortOrder])
  @@index([imageId])
  @@index([imageId2])
  @@index([imageId3])
  @@map("sales_order_spec_details")
}

/// 销售单「材料明细」里对物料清单的引用（用户 2026-09-24：「在编辑销售单的时候，每个部件，
/// 既支持填空，也支持从现有的物料清单中引用。同时要体现对应的物料的图片」）。
///
/// 为什么单独一张表而不是往 `sales_orders` 上再加 18 个 `*_material_id` 列：
/// 18 个可空外键列会把这行宽推到 60+ 列，而且「哪些栏位能引用」这件事本身是**材料明细清单**
/// （`SPEC_MATERIAL_FIELDS`）说了算的 —— 那张清单一改，列就得跟着加。一行一个引用
/// （`spec_key` + `material_id`）跟着清单走，不需要动 schema。
///
/// 为什么是**引用**而不是把图片抄进销售单：图片是物料主数据的属性，同一个伞骨用在十张单子上，
/// 抄十份之后改一次图要改十处。引用让「物料换图」立刻反映到所有引用它的销售单上，
/// 也让「导出时勾选哪张图」有唯一的事实来源。
///
/// 软删除 + `@@unique([salesOrderId, specKey])` 并存：换引用是**改这一行**（清 `deletedAt`、
/// 换 `materialId`），不是删一行建一行 —— 硬删会撞唯一索引，也会丢掉「这一格原来引用的是谁」。
model SalesOrderMaterialRef {
  id           String     @id @default(uuid()) @db.Uuid
  salesOrderId String     @map("sales_order_id") @db.Uuid
  /// 材料明细的 18 个栏位之一（与 `SPEC_MATERIAL_FIELDS` 的请求键同源：`rib_spec` / `canopy_spec` …）
  specKey      String     @map("spec_key") @db.VarChar(50)
  materialId   String     @map("material_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdBy    String     @map("created_by") @db.Uuid
  updatedBy    String     @map("updated_by") @db.Uuid
  deletedAt    DateTime?  @map("deleted_at")
  deletedBy    String?    @map("deleted_by") @db.Uuid
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  material     Material   @relation(fields: [materialId], references: [id])

  @@unique([salesOrderId, specKey])
  @@index([materialId])
  @@map("sales_order_material_refs")
}

/// 销售单「材料明细」末尾的「其它」行（用户 2026-10-08：「材料明细最后还需要加一个『其它』，
/// 可以自行添加类目。有时候还需要别的物料。允许用户增删改」）。
///
/// 为什么是**行**而不是继续往 `sales_orders` 上加列：上面那 18 项是模板上印死的栏位
/// （用户 2026-09-16 拍板「按两张样本的并集做成固定字段」），而「其它」的类目名是**用户自己起的**、
/// 条数也不固定 —— 列加不出来。
///
/// 为什么不复用 `SalesOrderSpecDetail`（同为「一行一条」的表）：那张表的形状是
/// 「分组名 + 品番/品名 + 颜色 + 条码 + 数量 + 单位」，导出时落在工艺单**下半部的明细区**；
/// 而「其它」是材料明细的一块、印在**材料区**，形状只有「类目 + 内容（+ 引用物料）」。
/// 塞进同一张表就得让导出侧靠 `groupName` 猜「这行到底是明细还是材料」，猜错就是整块版面错位。
///
/// 为什么 `materialId` 是**这一行上的可空外键**、而不是进 `sales_order_material_refs`：
/// 那张表的唯一键是 `(sales_order_id, spec_key)`，而 `spec_key` 的语义是「18 个栏位之一」——
/// 「其它」行的条数用户随时增删，没有稳定的栏位键。拿序号当键的话，删掉中间一行会让后面每一行的
/// 引用整体错位，而错位的表现是「图配到了别的物料上」，在纸上看不出来。
///
/// 与 `SalesOrderSpecDetail` 同一条替换语义（保存时软删旧的 + 建新的）：这张表上没有唯一键，
/// 所以行 id 每次保存都会变。图片导出候选因此按 `extra:<行 id>` 标识，且**每次导出都要重新拉一次
/// 候选**（销售单页面本来就是这么做的）。用行 id 而不是序号是有意的：候选过期时宁可报
/// 「这一格没有可导出的图片」，也不能把图悄悄配到另一行上。
model SalesOrderMaterialExtra {
  id           String           @id @default(uuid()) @db.Uuid
  salesOrderId String           @map("sales_order_id") @db.Uuid
  /// 类目名（用户自己起：弹簧 / 螺丝 / 胶袋 …）。必填 —— 它印在工艺单「材料」那一列。
  /// 2026-10-29 起还有第二种用法：`specKey` 非空时这不是用户起的名字，而是**服务端按 18 个固定类目
  /// 填的中文名**（「同类目再加一款」，见下面 `specKey`），前端传什么都会被覆盖。
  label        String           @db.VarChar(50)
  /// 所属固定类目（2026-10-29「同类目再加一款」）：18 个材料栏位之一的键（`handle_spec` / `canopy_spec` …）。
  /// 可空 = 原有「其它」自由类目行。非空时导出件把这一行**紧跟在该类目那一行之后**印，
  /// 用户填「3 款伞头」就得到 3 行「伞头」，而不是全堆在「其它」区。
  specKey      String?          @map("spec_key") @db.VarChar(40)
  /// 内容（规格说明）。可空：这一行可能只引用了物料，引用摘要会兜底印出来（与 18 格同一条规则）。
  content      String?          @db.VarChar(1000)
  /// 引用的物料（可空 = 只填文字）。用途与上面 18 格的引用完全一致：填字 + 带图。
  materialId   String?          @map("material_id") @db.Uuid
  /// 这一行自己挂的第 1 张图（2026-11-04，`sales_order_images` 的 id；2026-11-05 起最多 3 张）。
  /// 与 `materialId` 的关系：引用物料时导出优先用**这一行自己的图**（客户临时给的样照），
  /// 没有自己的图才回退到物料清单里那张。空 = 没挂图。
  imageId      String?          @map("image_id") @db.Uuid
  /// 第 2 张 / 第 3 张（2026-11-05「一条物料支持导入 3 张图片」）。空 = 没挂满 3 张。
  imageId2     String?          @map("image_id_2") @db.Uuid
  imageId3     String?          @map("image_id_3") @db.Uuid
  sortOrder    Int              @default(0) @map("sort_order")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  createdBy    String           @map("created_by") @db.Uuid
  updatedBy    String           @map("updated_by") @db.Uuid
  deletedAt    DateTime?        @map("deleted_at")
  deletedBy    String?          @map("deleted_by") @db.Uuid
  salesOrder   SalesOrder       @relation(fields: [salesOrderId], references: [id])
  /// ⚠️ `onDelete: SetNull` **必须写出来**（2026-10-08 补）：它是可空外键的 Prisma 默认值，
  /// 而迁移文件里当初按「外键一律 RESTRICT」写成了 `RESTRICT` —— 两边不一致就是 6 行**永久漂移**
  /// （`prisma migrate diff` 会一直要求把这条外键 DROP 掉再按 `SET NULL` 建回来）。
  /// 业务上这个值也是对的：`material_id` 可空（只填文字的行），物料被硬删时该行留着文字、只摘引用
  /// —— 与服务层 `usableMaterialExtras` 同一条口径；写死默认值是为了让它可见、不再被"顺手统一"掉。
  material     Material?        @relation(fields: [materialId], references: [id], onDelete: SetNull)
  image        SalesOrderImage? @relation("sales_order_material_extra_image_1", fields: [imageId], references: [id], onDelete: SetNull)
  image2       SalesOrderImage? @relation("sales_order_material_extra_image_2", fields: [imageId2], references: [id], onDelete: SetNull)
  image3       SalesOrderImage? @relation("sales_order_material_extra_image_3", fields: [imageId3], references: [id], onDelete: SetNull)

  @@index([salesOrderId, sortOrder])
  @@index([materialId])
  @@index([imageId])
  @@index([imageId2])
  @@index([imageId3])
  @@map("sales_order_material_extras")
}

/// 销售单行图片库（2026-11-04）。
///
/// 用户原话：「销售订单要支持每个物料插入图片……用户还需要比如说一个生产单里有 5 种伞布、
/// 11 种伞头，能在每种里插入图片」。
///
/// ## 为什么图片是**独立的库行**，而不是挂在材料行/明细行上
///
/// `sales_order_material_extras` 与 `sales_order_spec_details` 的替换语义都是「软删旧的 + 建新的」
/// （整块替换），**每次保存行 id 都会变**。字节挂在这些行上，保存一次要么丢图（新行没有字节），
/// 要么把整块图重新拷一遍（每次保存都复制几百 KB）。所以：图片先经 `POST /sales-orders/:id/images`
/// 上传成这一张单的**独立行**，材料行/明细行只存 `image_id` 指针，保存时搬运指针、不动字节；
/// 保存末尾再把「这一单里没有任何行引用的图片」软删（用户传了又取消的那种）。
///
/// ## 为什么按单隔离（`sales_order_id` 不可空）
///
/// 同一张图不会被别的销售单直接引用：返单/复制时服务端把字节**复制**成新单自己的行
/// （见 `sales-orders.service.ts` 的图片绑定逻辑），这样删一张单不会让另一张单的图变成破图，
/// 也不会出现跨单的 IDOR。
///
/// ## 字节口径与 `material_images` 完全一致
///
/// 浏览器压成 WebP 再传，服务端用同一个 `validateMaterialImage` 解开 RIFF 容器核对真实尺寸
/// （≤2MB、边长 ≤2000）；读接口用 `ETag = sha256` + `must-revalidate`。
model SalesOrderImage {
  id              String                    @id @default(uuid()) @db.Uuid
  salesOrderId    String                    @map("sales_order_id") @db.Uuid
  /// 图片字节（WebP）。PostgreSQL 的 bytea。
  data            Bytes
  mimeType        String                    @default("image/webp") @map("mime_type") @db.VarChar(50)
  width           Int
  height          Int
  byteSize        Int                       @map("byte_size")
  /// 内容摘要：`ETag` + 「换没换图」的唯一判断依据（与 `material_images.sha256` 同一口径）。
  sha256          String                    @db.VarChar(64)
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  createdBy       String                    @map("created_by") @db.Uuid
  updatedBy       String                    @map("updated_by") @db.Uuid
  deletedAt       DateTime?                 @map("deleted_at")
  deletedBy       String?                   @map("deleted_by") @db.Uuid
  salesOrder      SalesOrder                @relation(fields: [salesOrderId], references: [id])
  slotImages      SalesOrderSlotImage[]
  // 行图最多 3 张（2026-11-05）：同两张表之间有多条关系，Prisma 要求每条关系在两侧同名标注。
  materialExtras  SalesOrderMaterialExtra[] @relation("sales_order_material_extra_image_1")
  materialExtras2 SalesOrderMaterialExtra[] @relation("sales_order_material_extra_image_2")
  materialExtras3 SalesOrderMaterialExtra[] @relation("sales_order_material_extra_image_3")
  specDetails     SalesOrderSpecDetail[]    @relation("sales_order_spec_detail_image_1")
  specDetails2    SalesOrderSpecDetail[]    @relation("sales_order_spec_detail_image_2")
  specDetails3    SalesOrderSpecDetail[]    @relation("sales_order_spec_detail_image_3")

  @@index([salesOrderId])
  @@map("sales_order_images")
}

/// 「18 个材料类目 → 这一格自己的图」的映射（2026-11-04；2026-11-05 起一格最多 3 张）。
///
/// 为什么需要这张映射表：18 个材料格是 `sales_orders` 上的 18 个标量列（模板印死的栏位），
/// **没有行**可以挂 `image_id`；而「每格最多 3 张图」必须能表达出来（哪怕这一格没引用任何物料）。
/// 一行 = 一格的一张图；`slot_index` 是这一格里的第几张（0/1/2，按用户看到的顺序）。
/// 唯一键 `(sales_order_id, spec_key, slot_index)`；与 `sales_order_material_refs` 同一条
/// 「删了再建会撞唯一索引」的坑，所以替换也是**逐格逐张对齐**（复活/改 image_id），不是软删+新建。
model SalesOrderSlotImage {
  id           String          @id @default(uuid()) @db.Uuid
  salesOrderId String          @map("sales_order_id") @db.Uuid
  /// 材料明细的 18 个栏位之一（与 `SPEC_MATERIAL_FIELDS` 的请求键同源：`rib_spec` / `canopy_spec` …）
  specKey      String          @map("spec_key") @db.VarChar(50)
  /// 这一格里的第几张图（0 = 第 1 张，1 = 第 2 张，2 = 第 3 张）。2026-11-04 的单张数据全是 0。
  slotIndex    Int             @default(0) @map("slot_index")
  imageId      String          @map("image_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  createdBy    String          @map("created_by") @db.Uuid
  updatedBy    String          @map("updated_by") @db.Uuid
  deletedAt    DateTime?       @map("deleted_at")
  deletedBy    String?         @map("deleted_by") @db.Uuid
  salesOrder   SalesOrder      @relation(fields: [salesOrderId], references: [id])
  image        SalesOrderImage @relation(fields: [imageId], references: [id])

  @@unique([salesOrderId, specKey, slotIndex])
  @@index([salesOrderId])
  @@index([imageId])
  @@map("sales_order_slot_images")
}

model SalesOrderVersion {
  id           String     @id @default(uuid()) @db.Uuid
  salesOrderId String     @map("sales_order_id") @db.Uuid
  version      Int
  snapshot     Json
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdBy    String     @map("created_by") @db.Uuid
  updatedBy    String     @map("updated_by") @db.Uuid
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  boms         Bom[]

  @@unique([salesOrderId, version])
  @@map("sales_order_versions")
}

model Bom {
  id                  String            @id @default(uuid()) @db.Uuid
  orderNo             String            @map("order_no") @db.VarChar(100)
  salesOrderId        String            @map("sales_order_id") @db.Uuid
  salesOrderVersionId String            @map("sales_order_version_id") @db.Uuid
  version             Int               @default(1)
  status              String            @default("draft") @db.VarChar(30)
  formDefinitionId    String?           @map("form_definition_id") @db.Uuid
  extensionData       Json              @default("{}") @map("extension_data")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  createdBy           String            @map("created_by") @db.Uuid
  updatedBy           String            @map("updated_by") @db.Uuid
  deletedAt           DateTime?         @map("deleted_at")
  deletedBy           String?           @map("deleted_by") @db.Uuid
  salesOrder          SalesOrder        @relation(fields: [salesOrderId], references: [id])
  salesOrderVersion   SalesOrderVersion @relation(fields: [salesOrderVersionId], references: [id])
  formDefinition      FormDefinition?   @relation(fields: [formDefinitionId], references: [id])
  items               BomItem[]
  purchaseOrders      PurchaseOrder[]
  purchasePlans       PurchasePlan[]
  productionOrders    ProductionOrder[]

  @@index([salesOrderId])
  @@index([orderNo])
  @@map("boms")
}

model FormDefinition {
  id        String      @id @default(uuid()) @db.Uuid
  formKey   String      @map("form_key") @db.VarChar(80)
  version   Int
  status    String      @default("draft") @db.VarChar(30)
  name      String      @db.VarChar(100)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  createdBy String      @map("created_by") @db.Uuid
  updatedBy String      @map("updated_by") @db.Uuid
  deletedAt DateTime?   @map("deleted_at")
  deletedBy String?     @map("deleted_by") @db.Uuid
  fields    FormField[]
  boms      Bom[]

  @@unique([formKey, version])
  @@index([formKey, status])
  @@map("form_definitions")
}

model FormField {
  id               String         @id @default(uuid()) @db.Uuid
  formDefinitionId String         @map("form_definition_id") @db.Uuid
  fieldKey         String         @map("field_key") @db.VarChar(80)
  label            String         @db.VarChar(100)
  fieldType        String         @map("field_type") @db.VarChar(30)
  isRequired       Boolean        @default(false) @map("is_required")
  sortOrder        Int            @default(0) @map("sort_order")
  options          Json           @default("{}")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  createdBy        String         @map("created_by") @db.Uuid
  updatedBy        String         @map("updated_by") @db.Uuid
  formDefinition   FormDefinition @relation(fields: [formDefinitionId], references: [id])

  @@unique([formDefinitionId, fieldKey])
  @@map("form_fields")
}

model BomItem {
  id                  String              @id @default(uuid()) @db.Uuid
  bomId               String              @map("bom_id") @db.Uuid
  materialId          String              @map("material_id") @db.Uuid
  materialName        String              @map("material_name") @db.VarChar(200)
  model               String?             @db.VarChar(200)
  specificationModel  String?             @map("specification_model") @db.VarChar(200)
  color               String?             @db.VarChar(100)
  unitId              String?             @map("unit_id") @db.Uuid
  materialSnapshot    Json                @map("material_snapshot")
  requiredQuantity    Decimal             @map("required_quantity") @db.Decimal(18, 4)
  sequence            Int?
  productionBatchBase Decimal?            @map("production_batch_base") @db.Decimal(18, 4)
  baseUsage           Decimal?            @map("base_usage") @db.Decimal(18, 4)
  approvedUsage       Decimal?            @map("approved_usage") @db.Decimal(18, 4)
  unit                String              @db.VarChar(30)
  lossQuantity        Decimal?            @map("loss_quantity") @db.Decimal(18, 4)
  lossRate            Decimal?            @map("loss_rate") @db.Decimal(8, 4)
  extensionData       Json                @default("{}") @map("extension_data")
  // ---- BOM 行的默认供应商（2026-09-26，老板要求「BOM 表新增一个 column：供应商」）----
  // 用途是**备查**：这个部件通常找哪家做（伞骨找五金厂、伞布找纺织厂）。
  // 用户已明确：**不预填到采购单** —— 采购仍逐行自己选供应商，不改变既有采购流程。
  //   · 可空：历史 BOM 行没有供应商；
  //   · 存 `supplier_snapshot`：供应商被改名/停用之后，BOM 上仍要看得见当时记的是哪一家
  //     （与 `materialSnapshot` 同一条理由）；
  //   · 引用而不是抄名字：供应商主数据是唯一真源（抄十份、改一次要改十处）。
  supplierId          String?             @map("supplier_id") @db.Uuid
  supplierSnapshot    Json?               @map("supplier_snapshot")
  // ---- BOM 行的「参考单价」（2026-10-08）----
  // 用户原话：「采购计划要下单需要填写单价，但是BOM表没办法填写单价，检查一下这条链路。尤其是前端。」
  // 用户选定：**在 BOM 行上手填一个参考单价（含币种），新建采购计划时预填到计划行，仍可改**。
  // 它是「这个部件通常多少钱」的**备查/预填**信息，与默认供应商同一形状、同一地位：
  //   · 可空：历史 BOM 行没有价（`null` = 没填，与「填了 0」不是一件事）；
  //   · **不参与任何金额计算**：成本/毛利/应付一律取采购单上的实际单价
  //     （`finance-report-cost.service.ts` 的取价口径没变），落在这里的价不会自己变成钱；
  //   · 计划行仍是唯一真源：预填只是省一次手打，采购员按实际报价改掉它即可；
  //   · 币种按行记：一家供应商报美元、另一家报人民币，BOM 上不说清币种，预填到计划里
  //     会让"计划合计按币种分列"直接说谎（`purchase_plan_items.currency` 同一套字典）。
  referenceUnitPrice  Decimal?            @map("reference_unit_price") @db.Decimal(18, 4)
  referenceCurrency   String?             @map("reference_currency") @db.VarChar(10)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  createdBy           String              @map("created_by") @db.Uuid
  updatedBy           String              @map("updated_by") @db.Uuid
  deletedAt           DateTime?           @map("deleted_at")
  deletedBy           String?             @map("deleted_by") @db.Uuid
  bom                 Bom                 @relation(fields: [bomId], references: [id])
  material            Material            @relation(fields: [materialId], references: [id])
  unitRecord          Unit?               @relation(fields: [unitId], references: [id])
  /**
   * BOM 行的默认供应商（可选关系 → Postgres 侧必须是 ON DELETE SET NULL，见迁移注释）。
   */
  supplier            Supplier?           @relation(fields: [supplierId], references: [id])
  purchaseOrderItems  PurchaseOrderItem[]
  purchasePlanItems   PurchasePlanItem[]

  @@index([bomId])
  @@index([materialId])
  /// 「这个供应商供哪些部件」要能查（备查用途之外，将来按供应商归集也走它）。
  @@index([supplierId])
  @@map("bom_items")
}

model Unit {
  id                           String                              @id @default(uuid()) @db.Uuid
  name                         String                              @unique @db.VarChar(30)
  isActive                     Boolean                             @default(true) @map("is_active")
  remark                       String?                             @db.VarChar(500)
  createdAt                    DateTime                            @default(now()) @map("created_at")
  updatedAt                    DateTime                            @updatedAt @map("updated_at")
  createdBy                    String                              @map("created_by") @db.Uuid
  updatedBy                    String                              @map("updated_by") @db.Uuid
  deletedAt                    DateTime?                           @map("deleted_at")
  deletedBy                    String?                             @map("deleted_by") @db.Uuid
  materials                    Material[]
  bomItems                     BomItem[]
  purchaseOrderItems           PurchaseOrderItem[]
  purchasePlanItems            PurchasePlanItem[]
  rawMaterialInbounds          RawMaterialInbound[]
  inboundNotices               RawMaterialInboundNotice[]
  inventoryFacts               InventoryFact[]
  rawMaterialMovementLines     RawMaterialMovementLine[]
  operationCatalogs            OperationCatalog[]
  productionOrders             ProductionOrder[]
  productionOrderOperations    ProductionOrderOperation[]
  operationDailyReports        OperationDailyReport[]
  outsourceLogisticsBatches    OutsourceLogisticsBatch[]
  outsourceReturnTransfers     OutsourceReturnTransfer[]
  outsourceDirectShipments     OutsourceDirectShipment[]
  finishedGoodsInspections     FinishedGoodsInspectionSubmission[]
  finishedGoodsInbounds        FinishedGoodsInbound[]
  finishedGoodsDefectives      FinishedGoodsDefective[]
  finishedGoodsOutbounds       FinishedGoodsOutbound[]
  finishedGoodsOutboundNotices FinishedGoodsOutboundNotice[]
  finishedGoodsInboundNotices  FinishedGoodsInboundNotice[]
  customerReturns              CustomerReturn[]
  stocktakeLines               StocktakeLine[]

  @@map("units")
}

model Material {
  id                        String                     @id @default(uuid()) @db.Uuid
  materialCode              String                     @unique @map("material_code") @db.VarChar(80)
  // 唯一性口径：名称 + 规格型号 + 颜色 组合唯一（同名不同规格/颜色必须能并存）。
  // 缺省值写空串而不是 NULL —— PostgreSQL 唯一索引里 NULL 互不相等，写 NULL 会让索引失效
  // （迁移 20260912190000 已在库层 SET DEFAULT ''）。
  name                      String                     @db.VarChar(200)
  specificationModel        String?                    @default("") @map("specification_model") @db.VarChar(200)
  color                     String?                    @default("") @db.VarChar(100)
  defaultUnitId             String                     @map("default_unit_id") @db.Uuid
  materialType              String                     @default("raw_material") @map("material_type") @db.VarChar(30)
  isActive                  Boolean                    @default(true) @map("is_active")
  remark                    String?                    @db.VarChar(1000)
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  createdBy                 String                     @map("created_by") @db.Uuid
  updatedBy                 String                     @map("updated_by") @db.Uuid
  deletedAt                 DateTime?                  @map("deleted_at")
  deletedBy                 String?                    @map("deleted_by") @db.Uuid
  defaultUnit               Unit                       @relation(fields: [defaultUnitId], references: [id])
  bomItems                  BomItem[]
  purchaseOrderItems        PurchaseOrderItem[]
  purchasePlanItems         PurchasePlanItem[]
  rawMaterialInbounds       RawMaterialInbound[]
  inboundNotices            RawMaterialInboundNotice[]
  inventoryFacts            InventoryFact[]
  rawMaterialMovementLines  RawMaterialMovementLine[]
  outsourceLogisticsBatches OutsourceLogisticsBatch[]
  outsourceReturnTransfers  OutsourceReturnTransfer[]
  stocktakeLines            StocktakeLine[]
  image                     MaterialImage?
  salesOrderMaterialRefs    SalesOrderMaterialRef[]
  salesOrderMaterialExtras  SalesOrderMaterialExtra[]

  @@unique([name, specificationModel, color])
  @@index([defaultUnitId])
  @@map("materials")
}

/// 物料图片（用户 2026-09-24：「物料清单，要给物料配上图片。图片上传之后要压缩成 webp 再存进数据库里」）。
///
/// 为什么单独一张 1:1 从表、而不是在 `materials` 上加几列：`materials` 是**热表** ——
/// 采购、BOM、库存、生产到处都在 `findMany` 它（`include: { material: true }` 遍地都是），
/// 字节列一旦挂在主表上，每一次列表查询都会顺手把几百 KB 的图片读回来。
/// Prisma 只在该关系被**显式** select/include 时才取它，所以从表是这里唯一安全的形状。
///
/// 压缩口径：**浏览器**用 canvas 把图转成 WebP 再上传，服务端只**校验**
/// （RIFF/WEBP 容器 + VP8/VP8L/VP8X 尺寸 + 大小与边长上限，见 `material-image.ts`），不重新编码 ——
/// 用户明确选了「不引 sharp 那种原生依赖」这条路，所以服务端必须拒掉伪装成 WebP 的字节，
/// 而不是相信客户端给的 Content-Type。
model MaterialImage {
  id         String   @id @default(uuid()) @db.Uuid
  materialId String   @unique @map("material_id") @db.Uuid
  /// 图片字节（WebP）。PostgreSQL 的 bytea。
  data       Bytes
  mimeType   String   @default("image/webp") @map("mime_type") @db.VarChar(50)
  width      Int
  height     Int
  byteSize   Int      @map("byte_size")
  /// 内容摘要：既当 `ETag` 用，也是「换没换图」的唯一判断依据（`updatedAt` 粒度不够）。
  sha256     String   @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdBy  String   @map("created_by") @db.Uuid
  updatedBy  String   @map("updated_by") @db.Uuid
  material   Material @relation(fields: [materialId], references: [id])

  @@map("material_images")
}

model Supplier {
  id                             String                          @id @default(uuid()) @db.Uuid
  supplierCode                   String                          @unique @map("supplier_code") @db.VarChar(80)
  name                           String                          @unique @db.VarChar(200)
  contactName                    String?                         @map("contact_name") @db.VarChar(100)
  phone                          String?                         @db.VarChar(50)
  /// 地址（用户 2026-09-16：「供应商，需要多一个字段，地址」）。可空：历史供应商没有这一项。
  address                        String?                         @map("address") @db.VarChar(300)
  settlementInfo                 Json                            @default("{}") @map("settlement_info")
  isActive                       Boolean                         @default(true) @map("is_active")
  remark                         String?                         @db.VarChar(1000)
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")
  createdBy                      String                          @map("created_by") @db.Uuid
  updatedBy                      String                          @map("updated_by") @db.Uuid
  deletedAt                      DateTime?                       @map("deleted_at")
  deletedBy                      String?                         @map("deleted_by") @db.Uuid
  purchaseOrders                 PurchaseOrder[]
  purchaseOrderItems             PurchaseOrderItem[]
  bomItems                       BomItem[]
  purchasePlanItems              PurchasePlanItem[]
  rawMaterialInbounds            RawMaterialInbound[]
  payableSources                 PayableSource[]
  outsourcePayableSources        OutsourcePayableSource[]
  supplierPayableEntries         SupplierPayableEntry[]
  supplierPayments               SupplierPayment[]
  supplierPayableReconciliations SupplierPayableReconciliation[]

  @@map("suppliers")
}

model PurchaseOrder {
  id                             String                          @id @default(uuid()) @db.Uuid
  purchaseOrderNo                String                          @unique @map("purchase_order_no") @db.VarChar(100)
  orderNo                        String                          @map("order_no") @db.VarChar(100)
  salesOrderId                   String                          @map("sales_order_id") @db.Uuid
  bomId                          String?                         @map("bom_id") @db.Uuid
  bomVersion                     Int?                            @map("bom_version")
  bomSnapshot                    Json?                           @map("bom_snapshot")
  supplierId                     String?                         @map("supplier_id") @db.Uuid
  supplierSnapshot               Json?                           @map("supplier_snapshot")
  purchaseDate                   DateTime?                       @map("purchase_date")
  expectedDate                   DateTime?                       @map("expected_date")
  currency                       String                          @db.VarChar(10)
  status                         String                          @default("draft") @db.VarChar(30)
  totalAmount                    Decimal                         @default(0) @map("total_amount") @db.Decimal(18, 4)
  extensionData                  Json                            @default("{}") @map("extension_data")
  remark                         String?                         @db.VarChar(1000)
  /// 以下六列是「采购订单打印表」上要出现、系统里原本没有落点的字段（用户 2026-09-16：
  /// 「采购单里面要有…付款方式、交期条款、交货地址、厂家回签意见、厂家回签、主管签字」
  /// 「对应的，系统中采购单也要支持对这些字段进行填写和设置」）。
  ///
  /// 与明细/金额无关，因此允许在**已下单之后**继续填写（厂家回签本来就是下单之后才发生的）：
  /// 走单独的 `PATCH /purchase-orders/:id/print-fields`，不放开「草稿才可整体编辑」那道门。
  /// 付款方式按业务给的三项存文本（月结30天 / 月结60天 / 当月付款）：不做枚举校验，
  /// 以后加「月结90天」不用改后端。回签三格存文本（导出仍留空供手写，这里是我们自己的记录）。
  paymentTerms                   String?                         @map("payment_terms") @db.VarChar(50)
  deliveryTerms                  String?                         @map("delivery_terms") @db.VarChar(1000)
  deliveryAddress                String?                         @map("delivery_address") @db.VarChar(300)
  supplierReply                  String?                         @map("supplier_reply") @db.VarChar(1000)
  /// 厂家回签：文本（经办人 / 日期），不是布尔。
  supplierSigned                 String?                         @map("supplier_signed") @db.VarChar(200)
  supervisorSignature            String?                         @map("supervisor_signature") @db.VarChar(200)
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")
  createdBy                      String                          @map("created_by") @db.Uuid
  updatedBy                      String                          @map("updated_by") @db.Uuid
  deletedAt                      DateTime?                       @map("deleted_at")
  deletedBy                      String?                         @map("deleted_by") @db.Uuid
  salesOrder                     SalesOrder                      @relation(fields: [salesOrderId], references: [id])
  bom                            Bom?                            @relation(fields: [bomId], references: [id])
  supplier                       Supplier?                       @relation(fields: [supplierId], references: [id])
  items                          PurchaseOrderItem[]
  purchaseReceipts               PurchaseReceipt[]
  rawMaterialInbounds            RawMaterialInbound[]
  inboundNotices                 RawMaterialInboundNotice[]
  payableSources                 PayableSource[]
  outsourceLogisticsBatches      OutsourceLogisticsBatch[]
  outsourcePayableSources        OutsourcePayableSource[]
  supplierPayableEntries         SupplierPayableEntry[]
  supplierPayableReconciliations SupplierPayableReconciliation[]

  @@index([orderNo, status])
  @@index([supplierId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                        String                     @id @default(uuid()) @db.Uuid
  purchaseOrderId           String                     @map("purchase_order_id") @db.Uuid
  materialId                String                     @map("material_id") @db.Uuid
  materialSnapshot          Json                       @map("material_snapshot")
  unitId                    String                     @map("unit_id") @db.Uuid
  unitSnapshot              Json                       @map("unit_snapshot")
  bomItemId                 String?                    @map("bom_item_id") @db.Uuid
  /// 明细行的供应商**可空**：刚导入 BOM 明细时用户还没选供应商，草稿也要能存下来
  /// （用户 2026-09-17：「导入 BOM 明细，也视为对采购单的编辑，允许保存」）。
  /// 「一个采购单只有一个供应商」的不变式没丢，只是从数据库挪到了**下单门禁**：
  /// `assertOrderableItems` 要求每行都有供应商，而已下单才能登记到货，
  /// 所以任何有到货/质检/入库/应付事实的明细行必然有供应商。
  supplierId                String?                    @map("supplier_id") @db.Uuid
  supplierSnapshot          Json?                      @map("supplier_snapshot")
  model                     String?                    @db.VarChar(200)
  quantity                  Decimal                    @db.Decimal(18, 4)
  unitPrice                 Decimal                    @map("unit_price") @db.Decimal(18, 4)
  taxRate                   Decimal?                   @map("tax_rate") @db.Decimal(8, 4)
  extraFee                  Decimal                    @default(0) @map("extra_fee") @db.Decimal(18, 4)
  amount                    Decimal                    @db.Decimal(18, 4)
  expectedDate              DateTime?                  @map("expected_date")
  extensionData             Json                       @default("{}") @map("extension_data")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  createdBy                 String                     @map("created_by") @db.Uuid
  updatedBy                 String                     @map("updated_by") @db.Uuid
  deletedAt                 DateTime?                  @map("deleted_at")
  deletedBy                 String?                    @map("deleted_by") @db.Uuid
  purchaseOrder             PurchaseOrder              @relation(fields: [purchaseOrderId], references: [id])
  material                  Material                   @relation(fields: [materialId], references: [id])
  unit                      Unit                       @relation(fields: [unitId], references: [id])
  supplier                  Supplier?                  @relation(fields: [supplierId], references: [id])
  bomItem                   BomItem?                   @relation(fields: [bomItemId], references: [id])
  /// 反向关系：这一条采购明细是否由某一行采购计划下单而来（1:1，见 PurchasePlanItem）。
  purchasePlanItem          PurchasePlanItem?
  receipts                  PurchaseReceipt[]
  rawMaterialInbounds       RawMaterialInbound[]
  inboundNotices            RawMaterialInboundNotice[]
  payableSources            PayableSource[]
  outsourceLogisticsBatches OutsourceLogisticsBatch[]
  outsourcePayableSources   OutsourcePayableSource[]
  supplierPayableEntries    SupplierPayableEntry[]

  @@index([purchaseOrderId])
  @@index([supplierId])
  /// 新建采购单时要按 BOM 明细行归集「这一行已经下过多少」（bomItemOrderStatus）。
  @@index([bomItemId])
  @@map("purchase_order_items")
}

/// 采购计划（2026-09-27，老板要求「采购模块多一个采购计划栏目」）。
///
/// 为什么要独立成表、而不是继续拿采购单草稿当计划 —— 见
/// `docs/design/purchase-plan-and-supplier-collapse-2026-09-27.md` §1，一句话：**粒度不同**。
/// 采购单的粒度是「一个供应商 × 一个币种」（头部三格才有单一含义），计划是「一个销售单 / 一份 BOM」
/// （一张计划里同时有多个供应商的行）。把多供应商的工作台塞进单供应商的凭证里，
/// 头部就会长期处于「有时有意义、有时没意义」的状态。
///
/// 「一个 BOM 一份计划」由**部分唯一索引**保证（`deleted_at IS NULL` 上唯一），
/// 所以这里**只有 `@@index`，没有 `@unique`** —— 写 `@unique` 生成的是全量唯一索引，
/// 会让「软删一份计划之后再也建不出第二份」。照抄 `boms` 的先例
/// （`20260826100000_unique_editable_bom`）。
model PurchasePlan {
  id            String             @id @default(uuid()) @db.Uuid
  /// `PP-{YYYYMMDD}-{UUID前8位}`，与采购单号同格式（`PO-` 前缀）。
  planNo        String             @unique @map("plan_no") @db.VarChar(100)
  orderNo       String             @map("order_no") @db.VarChar(100)
  salesOrderId  String             @map("sales_order_id") @db.Uuid
  bomId         String             @map("bom_id") @db.Uuid
  bomVersion    Int?               @map("bom_version")
  /// BOM 被软删之后，计划上仍要看得见「这是哪一版 BOM 的计划」（它是独立存活的历史记录）。
  bomSnapshot   Json?              @map("bom_snapshot")
  extensionData Json               @default("{}") @map("extension_data")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  createdBy     String             @map("created_by") @db.Uuid
  updatedBy     String             @map("updated_by") @db.Uuid
  deletedAt     DateTime?          @map("deleted_at")
  deletedBy     String?            @map("deleted_by") @db.Uuid
  salesOrder    SalesOrder         @relation(fields: [salesOrderId], references: [id])
  bom           Bom                @relation(fields: [bomId], references: [id])
  items         PurchasePlanItem[]

  /// 列表按销售单/货号筛（货号走「订单号集合」反查，与返单模块同一口径）。
  @@index([orderNo])
  /// 与部分唯一索引并存：照抄 `boms` 的形状（schema 声明普通索引，SQL 里另建 partial unique）。
  @@index([bomId])
  @@map("purchase_plans")
}

/// 采购计划的一行 = 一个「采购意图」。
///
/// 数量与单价**可改**（BOM 要 100、实际只买 80 是常态）；`purchaseOrderItemId` 是
/// 「这一行已经下过单了」的**唯一表示**：
///   · 下单时在同一事务里建采购单 + 明细，再把这一列指过去；
///   · 「退回采购计划」把这一列清空 → 行回到未下单，而数量/单价/供应商**原样保留**（可逆，不用重录）；
///   · 多波次下单天然成立：一次只给勾选的行写链接。
/// `@unique` 保证一条采购明细只能被一行计划认领。
model PurchasePlanItem {
  id                  String             @id @default(uuid()) @db.Uuid
  planId              String             @map("plan_id") @db.Uuid
  materialId          String             @map("material_id") @db.Uuid
  materialSnapshot    Json               @map("material_snapshot")
  unitId              String             @map("unit_id") @db.Uuid
  unitSnapshot        Json               @map("unit_snapshot")
  /// 指向来源 BOM 行。BOM 外新增的补料/替代料为 null（沿用 `outside_bom_reason` 口径）。
  /// 注意：`BomsService.replaceItems` 会**换掉全部行 ID**，所以归集要按物料摊回，见 service 注释。
  bomItemId           String?            @map("bom_item_id") @db.Uuid
  /// 可空：计划允许先存下「还没定供应商」的行（与采购明细同一口径）。
  supplierId          String?            @map("supplier_id") @db.Uuid
  supplierSnapshot    Json?              @map("supplier_snapshot")
  model               String?            @db.VarChar(200)
  quantity            Decimal            @db.Decimal(18, 4)
  unitPrice           Decimal            @map("unit_price") @db.Decimal(18, 4)
  /// 这一行单价的币种（2026-09-30 用户：「添加价格字段，单价，总价」）。
  ///
  /// **币种按行记、不按计划头记**：一张计划里同时有多个供应商，而"一个币种"是
  /// **一张采购单**的属性（采购单粒度 = 一个供应商 × 一个币种）。固定在计划头上，
  /// 等于把"不同供应商可能报不同货币"从数据模型里删掉。
  ///
  /// 默认人民币；**「收束下单」时按该供应商组选的币种写回这一组每一行** ——
  /// 写回之后已下单行的币种永远等于那张采购单的币种（一次输入、两处记录，不是两次输入）。
  /// 「退回采购计划」不清这一列：退回的是"哪张单"，不是"谈的是哪国钱"。
  currency            String             @default("CNY") @map("currency") @db.VarChar(10)
  expectedDate        DateTime?          @map("expected_date")
  /// 已下单时指向采购明细；为空 = 未下单。见模型注释。
  purchaseOrderItemId String?            @unique @map("purchase_order_item_id") @db.Uuid
  sequence            Int?
  extensionData       Json               @default("{}") @map("extension_data")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  createdBy           String             @map("created_by") @db.Uuid
  updatedBy           String             @map("updated_by") @db.Uuid
  deletedAt           DateTime?          @map("deleted_at")
  deletedBy           String?            @map("deleted_by") @db.Uuid
  plan                PurchasePlan       @relation(fields: [planId], references: [id])
  material            Material           @relation(fields: [materialId], references: [id])
  unit                Unit               @relation(fields: [unitId], references: [id])
  supplier            Supplier?          @relation(fields: [supplierId], references: [id])
  bomItem             BomItem?           @relation(fields: [bomItemId], references: [id])
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])

  @@index([planId])
  @@index([supplierId])
  /// 「这张 BOM 的这一行已经计划了多少」要能查（下单状态的「计划中」档）。
  @@index([bomItemId])
  @@map("purchase_plan_items")
}

