  productionOrderNo         String                              @unique @map("production_order_no") @db.VarChar(100)
  orderNo                   String                              @map("order_no") @db.VarChar(100)
  salesOrderId              String                              @map("sales_order_id") @db.Uuid
  bomId                     String?                             @map("bom_id") @db.Uuid
  bomVersion                Int?                                @map("bom_version")
  bomSnapshot               Json?                               @map("bom_snapshot")
  productionOrderType       String                              @default("standard") @map("production_order_type") @db.VarChar(30)
  parentProductionOrderId   String?                             @map("parent_production_order_id") @db.Uuid
  executionMode             String                              @map("execution_mode") @db.VarChar(20)
  executionLocationId       String                              @map("execution_location_id") @db.Uuid
  plannedQuantity           Decimal                             @map("planned_quantity") @db.Decimal(18, 4)
  unitId                    String                              @map("unit_id") @db.Uuid
  productSpecification      String?                             @map("product_specification") @db.VarChar(1000)
  productionProcessNote     String?                             @map("production_process_note") @db.VarChar(2000)
  status                    String                              @default("draft") @db.VarChar(30)
  plannedStartedOn          DateTime?                           @map("planned_started_on") @db.Date
  deliveryDueOn             DateTime?                           @map("delivery_due_on") @db.Date
  startedOn                 DateTime?                           @map("started_on") @db.Date
  completedOn               DateTime?                           @map("completed_on") @db.Date
  actualCompletedQuantity   Decimal?                            @map("actual_completed_quantity") @db.Decimal(18, 4)
  remark                    String?                             @db.VarChar(1000)
  createdAt                 DateTime                            @default(now()) @map("created_at")
  updatedAt                 DateTime                            @updatedAt @map("updated_at")
  createdBy                 String                              @map("created_by") @db.Uuid
  updatedBy                 String                              @map("updated_by") @db.Uuid
  deletedAt                 DateTime?                           @map("deleted_at")
  deletedBy                 String?                             @map("deleted_by") @db.Uuid
  salesOrder                SalesOrder                          @relation(fields: [salesOrderId], references: [id])
  bom                       Bom?                                @relation(fields: [bomId], references: [id])
  parent                    ProductionOrder?                    @relation("production_order_parent", fields: [parentProductionOrderId], references: [id])
  children                  ProductionOrder[]                   @relation("production_order_parent")
  executionLocation         ProductionLocation                  @relation(fields: [executionLocationId], references: [id])
  unit                      Unit                                @relation(fields: [unitId], references: [id])
  operations                ProductionOrderOperation[]
  inventoryFacts            InventoryFact[]
  rawMaterialMovements      RawMaterialMovement[]
  operationDailyReports     OperationDailyReport[]
  employeeDailyReports      EmployeeDailyReport[]
  productionDailyAlerts     ProductionDailyAlert[]
  payrollSources            ProductionPayrollSource[]
  outsourceLogisticsBatches OutsourceLogisticsBatch[]
  outsourceReturnTransfers  OutsourceReturnTransfer[]
  outsourceDirectShipments  OutsourceDirectShipment[]
  finishedGoodsInspections  FinishedGoodsInspectionSubmission[]
  finishedGoodsInbounds     FinishedGoodsInbound[]
  finishedGoodsDefectives   FinishedGoodsDefective[]
  finishedGoodsOutbounds    FinishedGoodsOutbound[]
  finishedGoodsOutboundNotices FinishedGoodsOutboundNotice[]
  inboundNotices            FinishedGoodsInboundNotice[]
  customerReturns           CustomerReturn[]

  @@index([orderNo, status])
  @@index([salesOrderId, productionOrderType])
  @@map("production_orders")
}

model RawMaterialMovement {
  id                String                    @id @default(uuid()) @db.Uuid
  movementNo        String                    @unique @map("movement_no") @db.VarChar(100)
  documentType      String                    @default("issue") @map("document_type") @db.VarChar(30)
  status            String                    @default("draft") @db.VarChar(30)
  productionOrderId String                    @map("production_order_id") @db.Uuid
  // 领料单归属到具体工序：同一生产单下不同工序领的物料不同（订单号-生产单-工序-领料表）。
  // 历史数据没有工序，因此列可空；新建领料单由服务层强制要求。
  productionOrderOperationId String?          @map("production_order_operation_id") @db.Uuid
  orderNo           String                    @map("order_no") @db.VarChar(100)
  businessDate      DateTime                  @map("business_date") @db.Date
  reason            String?                   @db.VarChar(1000)
  remark            String?                   @db.VarChar(1000)
  /// 生产「确认提交」到仓库的时刻（draft → pending_outbound）。
  /// 为什么单独一列而不是复用 updatedAt：updatedAt 会被任何一次写入改动，
  /// 而仓库的「待出库通知」要显示的是「这张单是什么时候交过来的」，两次提交之间不能漂移。
  submittedAt       DateTime?                 @map("submitted_at")
  idempotencyKey    String                    @unique @map("idempotency_key") @db.VarChar(200)
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  createdBy         String                    @map("created_by") @db.Uuid
  updatedBy         String                    @map("updated_by") @db.Uuid
  deletedAt         DateTime?                 @map("deleted_at")
  deletedBy         String?                   @map("deleted_by") @db.Uuid
  productionOrder   ProductionOrder           @relation(fields: [productionOrderId], references: [id])
  productionOrderOperation ProductionOrderOperation? @relation(fields: [productionOrderOperationId], references: [id])
  lines             RawMaterialMovementLine[]
  risks             RawMaterialMovementRisk[]

  @@index([productionOrderId, status])
  @@index([productionOrderOperationId])
  @@index([orderNo, businessDate])
  /// 仓库「待出库通知」按 (status, submitted_at) 查最新待出库单据（索引由 20260916130000 迁移创建）。
  /// 必须在这里声明：手写迁移建了索引而 schema 不声明，`prisma migrate diff` 会一直想把它 DROP 掉，
  /// 形成永久漂移（同一个坑在仓库里已有 9 处历史遗留）。
  @@index([status, submittedAt])
  @@map("raw_material_movements")
}

model RawMaterialMovementLine {
  id                   String                    @id @default(uuid()) @db.Uuid
  movementId           String                    @map("movement_id") @db.Uuid
  materialId           String                    @map("material_id") @db.Uuid
  unitId               String                    @map("unit_id") @db.Uuid
  quantity             Decimal                   @db.Decimal(18, 4)
  bomReferenceQuantity Decimal?                  @map("bom_reference_quantity") @db.Decimal(18, 4)
  sourceIssueLineId    String?                   @map("source_issue_line_id") @db.Uuid
  remark               String?                   @db.VarChar(1000)
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  createdBy            String                    @map("created_by") @db.Uuid
  updatedBy            String                    @map("updated_by") @db.Uuid
  deletedAt            DateTime?                 @map("deleted_at")
  deletedBy            String?                   @map("deleted_by") @db.Uuid
  movement             RawMaterialMovement       @relation(fields: [movementId], references: [id])
  material             Material                  @relation(fields: [materialId], references: [id])
  unit                 Unit                      @relation(fields: [unitId], references: [id])
  sourceIssueLine      RawMaterialMovementLine?  @relation("raw_material_movement_source_issue", fields: [sourceIssueLineId], references: [id])
  derivedLines         RawMaterialMovementLine[] @relation("raw_material_movement_source_issue")
  inventoryFacts       InventoryFact[]
  risks                RawMaterialMovementRisk[]

  @@index([movementId])
  @@index([materialId, unitId])
  @@map("raw_material_movement_lines")
}

model RawMaterialMovementRisk {
  id          String                   @id @default(uuid()) @db.Uuid
  movementId  String                   @map("movement_id") @db.Uuid
  lineId      String?                  @map("line_id") @db.Uuid
  riskType    String                   @map("risk_type") @db.VarChar(50)
  context     Json                     @default("{}")
  reason      String                   @db.VarChar(1000)
  confirmedBy String                   @map("confirmed_by") @db.Uuid
  confirmedAt DateTime                 @default(now()) @map("confirmed_at")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  createdBy   String                   @map("created_by") @db.Uuid
  updatedBy   String                   @map("updated_by") @db.Uuid
  deletedAt   DateTime?                @map("deleted_at")
  deletedBy   String?                  @map("deleted_by") @db.Uuid
  movement    RawMaterialMovement      @relation(fields: [movementId], references: [id])
  line        RawMaterialMovementLine? @relation(fields: [lineId], references: [id])

  @@index([movementId, riskType])
  @@map("raw_material_movement_risks")
}

