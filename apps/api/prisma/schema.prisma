model Department {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique @db.VarChar(80)
  name      String     @unique @db.VarChar(100)
  isActive  Boolean    @default(true) @map("is_active")
  remark    String?    @db.VarChar(500)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  createdBy String     @map("created_by") @db.Uuid
  updatedBy String     @map("updated_by") @db.Uuid
  deletedAt DateTime?  @map("deleted_at")
  deletedBy String?    @map("deleted_by") @db.Uuid
  positions Position[]
  employees Employee[]

  @@map("departments")
}

model Position {
  id           String     @id @default(uuid()) @db.Uuid
  departmentId String     @map("department_id") @db.Uuid
  code         String     @db.VarChar(80)
  name         String     @db.VarChar(100)
  isActive     Boolean    @default(true) @map("is_active")
  remark       String?    @db.VarChar(500)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdBy    String     @map("created_by") @db.Uuid
  updatedBy    String     @map("updated_by") @db.Uuid
  deletedAt    DateTime?  @map("deleted_at")
  deletedBy    String?    @map("deleted_by") @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])
  employees    Employee[]

  @@unique([departmentId, code])
  @@index([departmentId, isActive])
  @@map("positions")
}

model Employee {
  id                 String                    @id @default(uuid()) @db.Uuid
  employeeNo         String                    @unique @map("employee_no") @db.VarChar(80)
  name               String                    @db.VarChar(100)
  departmentId       String                    @map("department_id") @db.Uuid
  positionId         String                    @map("position_id") @db.Uuid
  employeeType       String                    @map("employee_type") @db.VarChar(40)
  employmentStatus   String                    @default("active") @map("employment_status") @db.VarChar(30)
  userId             String?                   @map("user_id") @db.Uuid
  hiredOn            DateTime?                 @map("hired_on") @db.Date
  leftOn             DateTime?                 @map("left_on") @db.Date
  remark             String?                   @db.VarChar(500)
  // 员工花名册口径（人事导入模板新增）：身份信息、学历血型、社保商业险、合同起止与紧急联络。
  // 全部可空：历史员工没有这些信息，新建/导入时也允许先留空后补录。
  // 年龄、工龄、当月生日、合同到期提醒是由这些字段实时派生的展示列，不落库。
  birthDate          DateTime?                 @map("birth_date") @db.Date
  gender             String?                   @db.VarChar(10)
  ethnicity          String?                   @db.VarChar(50)
  idCardNo           String?                   @map("id_card_no") @db.VarChar(30)
  education          String?                   @db.VarChar(50)
  bloodType          String?                   @map("blood_type") @db.VarChar(10)
  socialInsurance    Boolean?                  @map("social_insurance")
  commercialInsurance Boolean?                 @map("commercial_insurance")
  contractStart      DateTime?                 @map("contract_start") @db.Date
  contractEnd        DateTime?                 @map("contract_end") @db.Date
  laborContractStart DateTime?                 @map("labor_contract_start") @db.Date
  laborContractEnd   DateTime?                 @map("labor_contract_end") @db.Date
  homeAddress        String?                   @map("home_address") @db.VarChar(500)
  currentAddress     String?                   @map("current_address") @db.VarChar(500)
  phone              String?                   @db.VarChar(50)
  emergencyContact   String?                   @map("emergency_contact") @db.VarChar(100)
  emergencyPhone     String?                   @map("emergency_phone") @db.VarChar(50)
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  createdBy          String                    @map("created_by") @db.Uuid
  updatedBy          String                    @map("updated_by") @db.Uuid
  deletedAt          DateTime?                 @map("deleted_at")
  deletedBy          String?                   @map("deleted_by") @db.Uuid
  department         Department                @relation(fields: [departmentId], references: [id])
  position           Position                  @relation(fields: [positionId], references: [id])
  operationRates     OperationRate[]
  dailyReports       EmployeeDailyReport[]
  payrollSources     ProductionPayrollSource[]
  attendanceRecords  AttendanceRecord[]
  performanceRecords PerformanceRecord[]
  payrollLedgers     PayrollLedger[]
    payrollPayables    PayrollPayableEntry[]

  @@index([departmentId, employmentStatus])
  @@index([positionId, employmentStatus])
  @@index([idCardNo])
  @@map("employees")
}

