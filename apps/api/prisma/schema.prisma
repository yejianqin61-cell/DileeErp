/// 收支流水：老表 `收支明细表.xls` 的数据源，「收支管理」板块的手工录入对象。
///
/// 与收付款单**不做自动联动**（用户 R6 选定「手工录入」）：`sourceType` / `sourceId` 本期恒空，
/// 是为将来联动预留的列。已确认的已知代价：收付款单过账后不会自动出现在这里，财务需要手工补录。
model CashFlowEntry {
  id                  String          @id @default(uuid()) @db.Uuid
  entryNo             String          @unique @map("entry_no") @db.VarChar(100)
  entryDate           DateTime        @map("entry_date") @db.Date
  /// 「对方名称」：老表要求一个统一字段；收付款单那边是 payerName / payeeName 分开且可为空
  counterpartyName    String          @map("counterparty_name") @db.VarChar(200)
  /// income / expense。金额恒为正数，方向由本字段决定（不存负数：否则「支出填成负数」无法校验）
  direction           String          @db.VarChar(10)
  amount              Decimal         @db.Decimal(18, 4)
  currency            String          @db.VarChar(10)
  exchangeRate        Decimal?        @map("exchange_rate") @db.Decimal(18, 6)
  localAmount         Decimal?        @map("local_amount") @db.Decimal(18, 4)
  /// 会计科目（分类 + 项目）。2026-09-17 之前这里是「收支项目」字典项，用户要求两者合并成一个。
  subjectId           String          @map("subject_id") @db.Uuid
  settlementMethod    String?         @map("settlement_method") @db.VarChar(50)
  settlementAccountId String?         @map("settlement_account_id") @db.Uuid
  /// 资金实际所在的**银行账户**（银行账户池 banks）。与 settlementAccountId（老表结算方式字典）是两回事：
  /// 字典是给人看的「转账--农业银行5706」，这里才是算银行余额的账。可空：历史流水与「不确定走哪张卡」的流水。
  bankId              String?         @map("bank_id") @db.Uuid
  /// 本期恒空，为将来与收付款单联动预留
  sourceType          String?         @map("source_type") @db.VarChar(40)
  sourceId            String?         @map("source_id") @db.Uuid
  /// 款项性质：定金 / 货款 / 尾款 / 其他（`PAYMENT_NATURES` 的 key）。
  ///
  /// 为什么需要它：老表 `example/财务/外汇一览表.xlsx` 把每个订单的到账拆成
  /// 「定金（日期+金额）/ 货款（日期+金额）」两组，用户 2026-09-17 要求把这套口径搬进系统。
  /// 系统里「钱进来」只有两条路 ——【确认应收】自动写一条流水、【收支流水】手工录一笔 ——
  /// 两条都落在本表上，所以标记只能加在这条**真正记了钱**的记录上（而不是某个单据上）。
  ///
  /// 可空：历史流水与「确实无所谓性质」的流水（房租、水电）不该被迫选一个。
  /// 报表把未标注的算进「其他到账」并留一行说明，不替财务猜。
  paymentNature       String?         @map("payment_nature") @db.VarChar(20)
  /// 订单号：把收入流水挂到具体订单。
  ///
  /// 为什么必须有：定金在**出货之前**就收到了，那时系统里还没有应收来源（应收来自成品出库），
  /// 因此手工录的定金流水没有任何自动来源可挂；外汇一览表要按订单归集定金，只能靠这个字段。
  /// 可空：非订单类收支（房租、水电、退税…）本来就没有订单号。
  orderNo             String?         @map("order_no") @db.VarChar(100)
  /// posted（生效）/ reversed（已冲销，保留行但报表不计入）
  status              String          @default("posted") @db.VarChar(30)
  remark              String?         @db.VarChar(1000)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  createdBy           String          @map("created_by") @db.Uuid
  updatedBy           String          @map("updated_by") @db.Uuid
  deletedAt           DateTime?       @map("deleted_at")
  deletedBy           String?         @map("deleted_by") @db.Uuid
  subject             AccountingSubject @relation(fields: [subjectId], references: [id])
  settlementAccount   DictionaryItem? @relation("CashFlowAccount", fields: [settlementAccountId], references: [id])
  bank                Bank?           @relation(fields: [bankId], references: [id])
  voucherLines        VoucherLine[]

  @@index([entryDate, currency])
  @@index([subjectId, direction])
  @@index([currency, status])
  @@index([bankId, status])
  /// 外汇一览表按订单号归集收款（定金流水没有来源可挂，只能按订单号找）。
  @@index([orderNo])
  @@map("cash_flow_entries")
}

/// 会计科目（全站财务口径的唯一来源）。
///
/// 来源与口径：用户 2026-09-17 交付 `example/财务/科目表(2).xls`，口径原文
/// 「那个编码的可以不管，分类就对应的是科目类别，项目就对应的是科目名称」。
/// 因此**只有两级**：`category`（分类）+ `name`（项目）；老表的科目代码整列不采纳。
///
/// 为什么不是 `dictionary_items` 的一种字典类型：科目表有「分类」这个维度，
/// 而 `dictionary_items` 是平表；硬塞一列 `category` 会让所有字典都背上一个只有本科目表
/// 才有意义的字段。用户也明确要求「收支项目维护和会计科目合并成一个会计科目」——
/// 合并后的东西是科目，不是字典。
///
/// 为什么 `balanceDirection` 留着：本期不参与计算，但凭证/账簿要靠它判断科目的自然余额方向；
/// 现在丢掉，以后要再问一次财务。
model AccountingSubject {
  id               String    @id @default(uuid()) @db.Uuid
  /// 分类 = 科目类别（资产类 / 负债类 / 成本类 / 所有者权益类 / 损益类）。
  category         String    @db.VarChar(30)
  /// 项目 = 科目名称（老表 B 列原文，含「销售- 办产地证」这类原表手误空格，照抄不改）。
  name             String    @db.VarChar(100)
  /// 余额方向：借 / 贷（老表 D 列原文）。本期只作口径参考，不参与任何计算。
  balanceDirection String?   @map("balance_direction") @db.VarChar(4)
  sortOrder        Int       @default(0) @map("sort_order")
  /// 停用而非删除：已被流水/单据引用的科目必须留成历史快照（宪法《Configurable Business Categories》）。
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdBy        String    @map("created_by") @db.Uuid
  updatedBy        String    @map("updated_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by") @db.Uuid
  cashFlowEntries               CashFlowEntry[]
  customerPayments              CustomerPayment[]
  supplierPayments              SupplierPayment[]
  receivableReconciliations     ReceivableReconciliation[]
  payableReconciliations        SupplierPayableReconciliation[]

  /// 同类别内科目名唯一：迁移与 seed 靠它做幂等种入。
  /// 不设全局唯一是有意的 —— 将来财务要在两个类别下各建一个同名明细科目时不必再迁移一次。
  @@unique([category, name])
  @@index([category, sortOrder])
  @@map("accounting_subjects")
}

/// 记账凭证。
///
/// 为什么是**结构化记录**而不是一张图片：凭证是账务事实，必须可查、可核、可追溯、可重打；
/// 图片不可搜索/不可复制/不可校对，且改一个字就要重新生成。图片（或 PDF）只是它的**渲染视图**：
/// 前端按「记账凭证纸」排版，浏览器打印 / 另存为 PDF 即可。
///
/// 当前来源只有 `cash_flow_entry`（每条收支流水一张凭证）与 `voucher`（红冲产生的红字凭证）。
model Voucher {
  id          String        @id @default(uuid()) @db.Uuid
  voucherNo   String        @unique @map("voucher_no") @db.VarChar(100)
  voucherDate DateTime      @map("voucher_date") @db.Date
  /// 会计期间 YYYY-MM（取自凭证日期），便于按期间出凭证清单
  period      String        @db.VarChar(7)
  /// 来源单据类型：cash_flow_entry / voucher（红冲）
  sourceType  String        @map("source_type") @db.VarChar(40)
  sourceId    String        @map("source_id") @db.Uuid
  summary     String        @db.VarChar(500)
  currency    String        @db.VarChar(10)
  /// 借贷合计（生成/编辑时校验相等；两边恒为正数，方向由分录的 direction 决定）
  debitTotal  Decimal       @map("debit_total") @db.Decimal(18, 4)
  creditTotal Decimal       @map("credit_total") @db.Decimal(18, 4)
  /// draft（可改可删）/ posted（已过账，不可改，只能红冲）/ reversed（已红冲）
  status      String        @default("draft") @db.VarChar(30)
  attachment  Json          @default("[]")
  remark      String?       @db.VarChar(1000)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  createdBy   String        @map("created_by") @db.Uuid
  updatedBy   String        @map("updated_by") @db.Uuid
  deletedAt   DateTime?     @map("deleted_at")
  deletedBy   String?       @map("deleted_by") @db.Uuid
  lines       VoucherLine[]

  /// 一条来源只能生成一张凭证 —— 生成接口因此天然幂等（重复点就是返回原凭证）
  @@unique([sourceType, sourceId])
  @@index([period, status])
  @@index([voucherDate])
  @@map("vouchers")
}

/// 凭证分录：借/贷各一行或多行。金额恒为正数，方向由 direction 决定（与收支流水同一约定）。
model VoucherLine {
  id               String        @id @default(uuid()) @db.Uuid
  voucherId        String        @map("voucher_id") @db.Uuid
  lineNo           Int           @map("line_no")
  /// debit / credit
  direction        String        @db.VarChar(10)
  /// 科目编码：当前取自「收支项目」字典的 key；将来接正式科目表时只改这一处取值来源
  subjectKey       String        @map("subject_key") @db.VarChar(200)
  /// 科目名快照：字典改名/停用后，历史凭证仍显示记账当时的科目名
  subjectLabel     String        @map("subject_label") @db.VarChar(200)
  summary          String        @db.VarChar(500)
  amount           Decimal       @db.Decimal(18, 4)
  currency         String        @db.VarChar(10)
  cashFlowEntryId  String?       @map("cash_flow_entry_id") @db.Uuid
  /// 资金类分录引用**具体的银行账户**（用户要求「会计科目的银行存款要引用具体的银行账户」）：
  /// 有它才能按账户出「银行存款明细账」、才能与银行对账单逐笔核对。科目名仍是「银行存款」，
  /// 这一列是明细/辅助核算引用；库存现金分录与手工改成非资金类科目的分录为 null。
  bankId           String?       @map("bank_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  createdBy        String        @map("created_by") @db.Uuid
  updatedBy        String        @map("updated_by") @db.Uuid
  voucher          Voucher       @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  cashFlowEntry    CashFlowEntry? @relation(fields: [cashFlowEntryId], references: [id])
  bank             Bank?         @relation(fields: [bankId], references: [id], onDelete: SetNull)

  @@unique([voucherId, lineNo])
  @@index([bankId])
  @@map("voucher_lines")
}

model ProductionOrder {
