generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique @db.VarChar(100)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  displayName  String     @map("display_name") @db.VarChar(100)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdBy    String     @map("created_by") @db.Uuid
  updatedBy    String     @map("updated_by") @db.Uuid
  deletedAt    DateTime?  @map("deleted_at")
  deletedBy    String?    @map("deleted_by") @db.Uuid
  roles        UserRole[]
  sessions     Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(128)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String   @map("created_by") @db.Uuid
  updatedBy String   @map("updated_by") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(80)
  name        String           @db.VarChar(100)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  createdBy   String           @map("created_by") @db.Uuid
  updatedBy   String           @map("updated_by") @db.Uuid
  deletedAt   DateTime?        @map("deleted_at")
  deletedBy   String?          @map("deleted_by") @db.Uuid
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleKey   String   @map("role_key") @db.VarChar(80)
  moduleKey String   @map("module_key") @db.VarChar(80)
  role      Role     @relation(fields: [roleKey], references: [key])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String   @map("created_by") @db.Uuid
  updatedBy String   @map("updated_by") @db.Uuid

  @@id([roleKey, moduleKey])
  @@map("role_permissions")
}

model DictionaryType {
  id        String           @id @default(uuid()) @db.Uuid
  key       String           @unique @db.VarChar(80)
  name      String           @db.VarChar(100)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  createdBy String           @map("created_by") @db.Uuid
  updatedBy String           @map("updated_by") @db.Uuid
  deletedAt DateTime?        @map("deleted_at")
  deletedBy String?          @map("deleted_by") @db.Uuid
  items     DictionaryItem[]

  @@map("dictionary_types")
}

model DictionaryItem {
  id        String         @id @default(uuid()) @db.Uuid
  typeId    String         @map("type_id") @db.Uuid
  key       String         @db.VarChar(80)
  label     String         @db.VarChar(100)
  sortOrder Int            @default(0) @map("sort_order")
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  createdBy String         @map("created_by") @db.Uuid
  updatedBy String         @map("updated_by") @db.Uuid
  deletedAt DateTime?      @map("deleted_at")
  deletedBy String?        @map("deleted_by") @db.Uuid
  type      DictionaryType @relation(fields: [typeId], references: [id])

  @@unique([typeId, key])
  @@map("dictionary_items")
}

model StateDefinition {
  id              String            @id @default(uuid()) @db.Uuid
  machineKey      String            @map("machine_key") @db.VarChar(80)
  key             String            @db.VarChar(80)
  label           String            @db.VarChar(100)
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  createdBy       String            @map("created_by") @db.Uuid
  updatedBy       String            @map("updated_by") @db.Uuid
  deletedAt       DateTime?         @map("deleted_at")
  deletedBy       String?           @map("deleted_by") @db.Uuid
  fromTransitions StateTransition[] @relation("from_state")
  toTransitions   StateTransition[] @relation("to_state")
  stateRecords    StateRecord[]

  @@unique([machineKey, key])
  @@map("state_definitions")
}

model StateRecord {
  id             String          @id @default(uuid()) @db.Uuid
  machineKey     String          @map("machine_key") @db.VarChar(80)
  entityType     String          @map("entity_type") @db.VarChar(80)
  entityId       String          @map("entity_id") @db.Uuid
  currentStateId String          @map("current_state_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  createdBy      String          @map("created_by") @db.Uuid
  updatedBy      String          @map("updated_by") @db.Uuid
  currentState   StateDefinition @relation(fields: [currentStateId], references: [id])
  changes        StateChange[]

  @@unique([machineKey, entityType, entityId])
  @@map("state_records")
}

model StateChange {
  id          String      @id @default(uuid()) @db.Uuid
  recordId    String      @map("record_id") @db.Uuid
  fromStateId String?     @map("from_state_id") @db.Uuid
  toStateId   String      @map("to_state_id") @db.Uuid
  remark      String?     @db.VarChar(500)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  createdBy   String      @map("created_by") @db.Uuid
  updatedBy   String      @map("updated_by") @db.Uuid
  record      StateRecord @relation(fields: [recordId], references: [id])

  @@index([recordId, createdAt])
  @@map("state_changes")
}

model StateTransition {
  id          String          @id @default(uuid()) @db.Uuid
  machineKey  String          @map("machine_key") @db.VarChar(80)
  fromStateId String          @map("from_state_id") @db.Uuid
  toStateId   String          @map("to_state_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  createdBy   String          @map("created_by") @db.Uuid
  updatedBy   String          @map("updated_by") @db.Uuid
  fromState   StateDefinition @relation("from_state", fields: [fromStateId], references: [id])
  toState     StateDefinition @relation("to_state", fields: [toStateId], references: [id])

  @@unique([machineKey, fromStateId, toStateId])
  @@map("state_transitions")
}

model Attachment {
  id         String           @id @default(uuid()) @db.Uuid
  fileName   String           @map("file_name") @db.VarChar(255)
  storageKey String           @unique @map("storage_key") @db.VarChar(500)
  mimeType   String           @map("mime_type") @db.VarChar(150)
  fileSize   BigInt           @map("file_size")
  sha256     String           @db.Char(64)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  createdBy  String           @map("created_by") @db.Uuid
  updatedBy  String           @map("updated_by") @db.Uuid
  deletedAt  DateTime?        @map("deleted_at")
  deletedBy  String?          @map("deleted_by") @db.Uuid
  links      AttachmentLink[]

  @@map("attachments")
}

model AttachmentLink {
  id           String     @id @default(uuid()) @db.Uuid
  attachmentId String     @map("attachment_id") @db.Uuid
  entityType   String     @map("entity_type") @db.VarChar(80)
  entityId     String     @map("entity_id") @db.Uuid
  remark       String?    @db.VarChar(500)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdBy    String     @map("created_by") @db.Uuid
  updatedBy    String     @map("updated_by") @db.Uuid
  attachment   Attachment @relation(fields: [attachmentId], references: [id])

  @@index([entityType, entityId])
  @@map("attachment_links")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  orderNo    String?  @map("order_no") @db.VarChar(100)
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_events")
}

model Customer {
  id            String            @id @default(uuid()) @db.Uuid
  customerCode  String            @unique @map("customer_code") @db.VarChar(80)
  name          String            @unique @db.VarChar(200)
  countryRegion String?           @map("country_region") @db.VarChar(100)
  address       String?           @db.VarChar(500)
  paymentTerms  String?           @map("payment_terms") @db.VarChar(200)
  currency      String?           @db.VarChar(10)
  remark        String?           @db.VarChar(1000)
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  createdBy     String            @map("created_by") @db.Uuid
  updatedBy     String            @map("updated_by") @db.Uuid
  deletedAt     DateTime?         @map("deleted_at")
  deletedBy     String?           @map("deleted_by") @db.Uuid
  contacts      CustomerContact[]
  salesOrders   SalesOrder[]

  @@map("customers")
}

model CustomerContact {
  id          String       @id @default(uuid()) @db.Uuid
  customerId  String       @map("customer_id") @db.Uuid
  name        String       @db.VarChar(100)
  position    String?      @db.VarChar(100)
  phone       String?      @db.VarChar(50)
  email       String?      @db.VarChar(200)
  isDefault   Boolean      @default(false) @map("is_default")
  remark      String?      @db.VarChar(500)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  createdBy   String       @map("created_by") @db.Uuid
  updatedBy   String       @map("updated_by") @db.Uuid
  deletedAt   DateTime?    @map("deleted_at")
  deletedBy   String?      @map("deleted_by") @db.Uuid
  customer    Customer     @relation(fields: [customerId], references: [id])
  salesOrders SalesOrder[]

  @@index([customerId, isActive])
  @@map("customer_contacts")
}

model SalesOrder {
  id                 String              @id @default(uuid()) @db.Uuid
  orderNo            String              @unique @map("order_no") @db.VarChar(100)
  customerId         String              @map("customer_id") @db.Uuid
  contactId          String?             @map("contact_id") @db.Uuid
  customerSnapshot   Json                @map("customer_snapshot")
  contactSnapshot    Json?               @map("contact_snapshot")
  customerPoNo       String?             @map("customer_po_no") @db.VarChar(100)
  externalContractNo String?             @map("external_contract_no") @db.VarChar(100)
  orderDate          DateTime            @map("order_date")
  productName        String              @map("product_name") @db.VarChar(200)
  productSpec        String?             @map("product_spec") @db.VarChar(1000)
  quantity           Decimal             @db.Decimal(18, 4)
  unit               String              @db.VarChar(30)
  deliveryDate       DateTime?           @map("delivery_date")
  currency           String              @db.VarChar(10)
  unitPrice          Decimal?            @map("unit_price") @db.Decimal(18, 4)
  totalAmount        Decimal?            @map("total_amount") @db.Decimal(18, 4)
  taxRate            Decimal?            @map("tax_rate") @db.Decimal(8, 4)
  status             String              @default("draft") @db.VarChar(30)
  currentVersion     Int                 @default(1) @map("current_version")
  extensionData      Json                @default("{}") @map("extension_data")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  createdBy          String              @map("created_by") @db.Uuid
  updatedBy          String              @map("updated_by") @db.Uuid
  deletedAt          DateTime?           @map("deleted_at")
  deletedBy          String?             @map("deleted_by") @db.Uuid
  customer           Customer            @relation(fields: [customerId], references: [id])
  contact            CustomerContact?    @relation(fields: [contactId], references: [id])
  versions           SalesOrderVersion[]
  boms               Bom[]
  purchaseOrders     PurchaseOrder[]

  @@index([customerId, status])
  @@index([orderDate])
  @@map("sales_orders")
}

model SalesOrderVersion {
  id           String     @id @default(uuid()) @db.Uuid
  salesOrderId String     @map("sales_order_id") @db.Uuid
  version      Int
  snapshot     Json
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdBy    String     @map("created_by") @db.Uuid
  updatedBy    String     @map("updated_by") @db.Uuid
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  boms         Bom[]

  @@unique([salesOrderId, version])
  @@map("sales_order_versions")
}

model Bom {
  id                  String            @id @default(uuid()) @db.Uuid
  orderNo             String            @map("order_no") @db.VarChar(100)
  salesOrderId        String            @map("sales_order_id") @db.Uuid
  salesOrderVersionId String            @map("sales_order_version_id") @db.Uuid
  version             Int               @default(1)
  status              String            @default("draft") @db.VarChar(30)
  formDefinitionId    String?           @map("form_definition_id") @db.Uuid
  extensionData       Json              @default("{}") @map("extension_data")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  createdBy           String            @map("created_by") @db.Uuid
  updatedBy           String            @map("updated_by") @db.Uuid
  deletedAt           DateTime?         @map("deleted_at")
  deletedBy           String?           @map("deleted_by") @db.Uuid
  salesOrder          SalesOrder        @relation(fields: [salesOrderId], references: [id])
  salesOrderVersion   SalesOrderVersion @relation(fields: [salesOrderVersionId], references: [id])
  formDefinition      FormDefinition?   @relation(fields: [formDefinitionId], references: [id])
  items               BomItem[]
  purchaseOrders      PurchaseOrder[]

  @@unique([salesOrderId, version])
  @@index([orderNo])
  @@map("boms")
}

model FormDefinition {
  id        String      @id @default(uuid()) @db.Uuid
  formKey   String      @map("form_key") @db.VarChar(80)
  version   Int
  status    String      @default("draft") @db.VarChar(30)
  name      String      @db.VarChar(100)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  createdBy String      @map("created_by") @db.Uuid
  updatedBy String      @map("updated_by") @db.Uuid
  deletedAt DateTime?   @map("deleted_at")
  deletedBy String?     @map("deleted_by") @db.Uuid
  fields    FormField[]
  boms      Bom[]

  @@unique([formKey, version])
  @@index([formKey, status])
  @@map("form_definitions")
}

model FormField {
  id               String         @id @default(uuid()) @db.Uuid
  formDefinitionId String         @map("form_definition_id") @db.Uuid
  fieldKey         String         @map("field_key") @db.VarChar(80)
  label            String         @db.VarChar(100)
  fieldType        String         @map("field_type") @db.VarChar(30)
  isRequired       Boolean        @default(false) @map("is_required")
  sortOrder        Int            @default(0) @map("sort_order")
  options          Json           @default("{}")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  createdBy        String         @map("created_by") @db.Uuid
  updatedBy        String         @map("updated_by") @db.Uuid
  formDefinition   FormDefinition @relation(fields: [formDefinitionId], references: [id])

  @@unique([formDefinitionId, fieldKey])
  @@map("form_fields")
}

model BomItem {
  id                 String              @id @default(uuid()) @db.Uuid
  bomId              String              @map("bom_id") @db.Uuid
  materialId         String              @map("material_id") @db.Uuid
  unitId             String?             @map("unit_id") @db.Uuid
  materialSnapshot   Json                @map("material_snapshot")
  requiredQuantity   Decimal             @map("required_quantity") @db.Decimal(18, 4)
  unit               String              @db.VarChar(30)
  lossQuantity       Decimal?            @map("loss_quantity") @db.Decimal(18, 4)
  lossRate           Decimal?            @map("loss_rate") @db.Decimal(8, 4)
  extensionData      Json                @default("{}") @map("extension_data")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  createdBy          String              @map("created_by") @db.Uuid
  updatedBy          String              @map("updated_by") @db.Uuid
  deletedAt          DateTime?           @map("deleted_at")
  deletedBy          String?             @map("deleted_by") @db.Uuid
  bom                Bom                 @relation(fields: [bomId], references: [id])
  material           Material            @relation(fields: [materialId], references: [id])
  unitRecord         Unit?               @relation(fields: [unitId], references: [id])
  purchaseOrderItems PurchaseOrderItem[]

  @@index([bomId])
  @@index([materialId])
  @@map("bom_items")
}

model Unit {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @unique @db.VarChar(30)
  isActive            Boolean              @default(true) @map("is_active")
  remark              String?              @db.VarChar(500)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  createdBy           String               @map("created_by") @db.Uuid
  updatedBy           String               @map("updated_by") @db.Uuid
  deletedAt           DateTime?            @map("deleted_at")
  deletedBy           String?              @map("deleted_by") @db.Uuid
  materials           Material[]
  bomItems            BomItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  rawMaterialInbounds RawMaterialInbound[]
  inventoryFacts      InventoryFact[]
  operationCatalogs   OperationCatalog[]

  @@map("units")
}

model Material {
  id                  String               @id @default(uuid()) @db.Uuid
  materialCode        String               @unique @map("material_code") @db.VarChar(80)
  name                String               @unique @db.VarChar(200)
  defaultUnitId       String               @map("default_unit_id") @db.Uuid
  isActive            Boolean              @default(true) @map("is_active")
  remark              String?              @db.VarChar(1000)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  createdBy           String               @map("created_by") @db.Uuid
  updatedBy           String               @map("updated_by") @db.Uuid
  deletedAt           DateTime?            @map("deleted_at")
  deletedBy           String?              @map("deleted_by") @db.Uuid
  defaultUnit         Unit                 @relation(fields: [defaultUnitId], references: [id])
  bomItems            BomItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  rawMaterialInbounds RawMaterialInbound[]
  inventoryFacts      InventoryFact[]

  @@index([defaultUnitId])
  @@map("materials")
}

model Supplier {
  id                  String               @id @default(uuid()) @db.Uuid
  supplierCode        String               @unique @map("supplier_code") @db.VarChar(80)
  name                String               @unique @db.VarChar(200)
  contactName         String?              @map("contact_name") @db.VarChar(100)
  phone               String?              @db.VarChar(50)
  settlementInfo      Json                 @default("{}") @map("settlement_info")
  isActive            Boolean              @default(true) @map("is_active")
  remark              String?              @db.VarChar(1000)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  createdBy           String               @map("created_by") @db.Uuid
  updatedBy           String               @map("updated_by") @db.Uuid
  deletedAt           DateTime?            @map("deleted_at")
  deletedBy           String?              @map("deleted_by") @db.Uuid
  purchaseOrders      PurchaseOrder[]
  rawMaterialInbounds RawMaterialInbound[]
  payableSources      PayableSource[]

  @@map("suppliers")
}

model PurchaseOrder {
  id                  String               @id @default(uuid()) @db.Uuid
  purchaseOrderNo     String               @unique @map("purchase_order_no") @db.VarChar(100)
  orderNo             String               @map("order_no") @db.VarChar(100)
  salesOrderId        String               @map("sales_order_id") @db.Uuid
  bomId               String               @map("bom_id") @db.Uuid
  bomVersion          Int                  @map("bom_version")
  bomSnapshot         Json                 @map("bom_snapshot")
  supplierId          String               @map("supplier_id") @db.Uuid
  supplierSnapshot    Json                 @map("supplier_snapshot")
  purchaseDate        DateTime             @map("purchase_date")
  expectedDate        DateTime?            @map("expected_date")
  currency            String               @db.VarChar(10)
  status              String               @default("draft") @db.VarChar(30)
  totalAmount         Decimal              @default(0) @map("total_amount") @db.Decimal(18, 4)
  extensionData       Json                 @default("{}") @map("extension_data")
  remark              String?              @db.VarChar(1000)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  createdBy           String               @map("created_by") @db.Uuid
  updatedBy           String               @map("updated_by") @db.Uuid
  deletedAt           DateTime?            @map("deleted_at")
  deletedBy           String?              @map("deleted_by") @db.Uuid
  salesOrder          SalesOrder           @relation(fields: [salesOrderId], references: [id])
  bom                 Bom                  @relation(fields: [bomId], references: [id])
  supplier            Supplier             @relation(fields: [supplierId], references: [id])
  items               PurchaseOrderItem[]
  purchaseReceipts    PurchaseReceipt[]
  rawMaterialInbounds RawMaterialInbound[]
  payableSources      PayableSource[]

  @@index([orderNo, status])
  @@index([supplierId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                  String               @id @default(uuid()) @db.Uuid
  purchaseOrderId     String               @map("purchase_order_id") @db.Uuid
  materialId          String               @map("material_id") @db.Uuid
  materialSnapshot    Json                 @map("material_snapshot")
  unitId              String               @map("unit_id") @db.Uuid
  unitSnapshot        Json                 @map("unit_snapshot")
  bomItemId           String?              @map("bom_item_id") @db.Uuid
  quantity            Decimal              @db.Decimal(18, 4)
  unitPrice           Decimal              @map("unit_price") @db.Decimal(18, 4)
  taxRate             Decimal?             @map("tax_rate") @db.Decimal(8, 4)
  extraFee            Decimal              @default(0) @map("extra_fee") @db.Decimal(18, 4)
  amount              Decimal              @db.Decimal(18, 4)
  extensionData       Json                 @default("{}") @map("extension_data")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  createdBy           String               @map("created_by") @db.Uuid
  updatedBy           String               @map("updated_by") @db.Uuid
  deletedAt           DateTime?            @map("deleted_at")
  deletedBy           String?              @map("deleted_by") @db.Uuid
  purchaseOrder       PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id])
  material            Material             @relation(fields: [materialId], references: [id])
  unit                Unit                 @relation(fields: [unitId], references: [id])
  bomItem             BomItem?             @relation(fields: [bomItemId], references: [id])
  receipts            PurchaseReceipt[]
  rawMaterialInbounds RawMaterialInbound[]
  payableSources      PayableSource[]

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model PurchaseReceipt {
  id                  String               @id @default(uuid()) @db.Uuid
  purchaseOrderId     String               @map("purchase_order_id") @db.Uuid
  purchaseOrderItemId String               @map("purchase_order_item_id") @db.Uuid
  orderNo             String               @map("order_no") @db.VarChar(100)
  receiptNo           String               @unique @map("receipt_no") @db.VarChar(100)
  referenceNo         String?              @map("reference_no") @db.VarChar(100)
  receivedDate        DateTime             @map("received_date")
  quantity            Decimal              @db.Decimal(18, 4)
  status              String               @default("received") @db.VarChar(30)
  remark              String?              @db.VarChar(1000)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  createdBy           String               @map("created_by") @db.Uuid
  updatedBy           String               @map("updated_by") @db.Uuid
  deletedAt           DateTime?            @map("deleted_at")
  deletedBy           String?              @map("deleted_by") @db.Uuid
  purchaseOrder       PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderItem   PurchaseOrderItem    @relation(fields: [purchaseOrderItemId], references: [id])
  inspections         IncomingInspection[]
  rawMaterialInbounds RawMaterialInbound[]

  @@index([purchaseOrderItemId, receivedDate])
  @@index([orderNo])
  @@map("purchase_receipts")
}

model IncomingInspection {
  id                  String               @id @default(uuid()) @db.Uuid
  purchaseReceiptId   String               @map("purchase_receipt_id") @db.Uuid
  orderNo             String               @map("order_no") @db.VarChar(100)
  inspectedQuantity   Decimal              @map("inspected_quantity") @db.Decimal(18, 4)
  acceptedQuantity    Decimal              @map("accepted_quantity") @db.Decimal(18, 4)
  conditionalQuantity Decimal              @map("conditional_quantity") @db.Decimal(18, 4)
  rejectedQuantity    Decimal              @map("rejected_quantity") @db.Decimal(18, 4)
  status              String               @default("pending") @db.VarChar(30)
  extensionData       Json                 @default("{}") @map("extension_data")
  remark              String?              @db.VarChar(1000)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  createdBy           String               @map("created_by") @db.Uuid
  updatedBy           String               @map("updated_by") @db.Uuid
  deletedAt           DateTime?            @map("deleted_at")
  deletedBy           String?              @map("deleted_by") @db.Uuid
  purchaseReceipt     PurchaseReceipt      @relation(fields: [purchaseReceiptId], references: [id])
  rawMaterialInbounds RawMaterialInbound[]

  @@index([purchaseReceiptId])
  @@index([orderNo])
  @@map("incoming_inspections")
}

model RawMaterialInbound {
  id                   String             @id @default(uuid()) @db.Uuid
  inboundNo            String             @unique @map("inbound_no") @db.VarChar(100)
  orderNo              String             @map("order_no") @db.VarChar(100)
  purchaseOrderId      String             @map("purchase_order_id") @db.Uuid
  purchaseOrderItemId  String             @map("purchase_order_item_id") @db.Uuid
  purchaseReceiptId    String             @map("purchase_receipt_id") @db.Uuid
  incomingInspectionId String             @map("incoming_inspection_id") @db.Uuid
  materialId           String             @map("material_id") @db.Uuid
  supplierId           String             @map("supplier_id") @db.Uuid
  quantity             Decimal            @db.Decimal(18, 4)
  inventoryCategory    String             @map("inventory_category") @db.VarChar(30)
  status               String             @default("draft") @db.VarChar(30)
  idempotencyKey       String             @unique @map("idempotency_key") @db.VarChar(200)
  remark               String?            @db.VarChar(1000)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  createdBy            String             @map("created_by") @db.Uuid
  updatedBy            String             @map("updated_by") @db.Uuid
  deletedAt            DateTime?          @map("deleted_at")
  deletedBy            String?            @map("deleted_by") @db.Uuid
  purchaseOrder        PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderItem    PurchaseOrderItem  @relation(fields: [purchaseOrderItemId], references: [id])
  purchaseReceipt      PurchaseReceipt    @relation(fields: [purchaseReceiptId], references: [id])
  incomingInspection   IncomingInspection @relation(fields: [incomingInspectionId], references: [id])
  material             Material           @relation(fields: [materialId], references: [id])
  supplier             Supplier           @relation(fields: [supplierId], references: [id])
  inventoryFacts       InventoryFact[]
  payableSources       PayableSource[]
  unit                 Unit?              @relation(fields: [unitId], references: [id])
  unitId               String?            @map("unit_id") @db.Uuid

  @@index([orderNo])
  @@map("raw_material_inbounds")
}

model InventoryFact {
  id                   String             @id @default(uuid()) @db.Uuid
  rawMaterialInboundId String             @map("raw_material_inbound_id") @db.Uuid
  materialId           String             @map("material_id") @db.Uuid
  inventoryCategory    String             @map("inventory_category") @db.VarChar(30)
  quantityDelta        Decimal            @map("quantity_delta") @db.Decimal(18, 4)
  createdAt            DateTime           @default(now()) @map("created_at")
  createdBy            String             @map("created_by") @db.Uuid
  rawMaterialInbound   RawMaterialInbound @relation(fields: [rawMaterialInboundId], references: [id])
  material             Material           @relation(fields: [materialId], references: [id])
  unit                 Unit?              @relation(fields: [unitId], references: [id])
  unitId               String?            @map("unit_id") @db.Uuid

  @@index([materialId, inventoryCategory])
  @@map("inventory_facts")
}

model PayableSource {
  id                   String             @id @default(uuid()) @db.Uuid
  rawMaterialInboundId String             @map("raw_material_inbound_id") @db.Uuid
  orderNo              String             @map("order_no") @db.VarChar(100)
  purchaseOrderId      String             @map("purchase_order_id") @db.Uuid
  purchaseOrderItemId  String             @map("purchase_order_item_id") @db.Uuid
  supplierId           String             @map("supplier_id") @db.Uuid
  quantity             Decimal            @db.Decimal(18, 4)
  unitPrice            Decimal            @map("unit_price") @db.Decimal(18, 4)
  currency             String             @db.VarChar(10)
  taxRate              Decimal?           @map("tax_rate") @db.Decimal(8, 4)
  amount               Decimal            @db.Decimal(18, 4)
  status               String             @default("pending_finance") @db.VarChar(30)
  idempotencyKey       String             @unique @map("idempotency_key") @db.VarChar(200)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  createdBy            String             @map("created_by") @db.Uuid
  updatedBy            String             @map("updated_by") @db.Uuid
  rawMaterialInbound   RawMaterialInbound @relation(fields: [rawMaterialInboundId], references: [id])
  supplier             Supplier           @relation(fields: [supplierId], references: [id])
  purchaseOrder        PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderItem    PurchaseOrderItem  @relation(fields: [purchaseOrderItemId], references: [id])

  @@unique([rawMaterialInboundId])
  @@index([orderNo])
  @@map("payable_sources")
}

model Department {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(80)
  name        String     @unique @db.VarChar(100)
  isActive    Boolean    @default(true) @map("is_active")
  remark      String?    @db.VarChar(500)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  createdBy   String     @map("created_by") @db.Uuid
  updatedBy   String     @map("updated_by") @db.Uuid
  deletedAt   DateTime?  @map("deleted_at")
  deletedBy   String?    @map("deleted_by") @db.Uuid
  positions   Position[]
  employees   Employee[]

  @@map("departments")
}

model Position {
  id           String     @id @default(uuid()) @db.Uuid
  departmentId String     @map("department_id") @db.Uuid
  code         String     @db.VarChar(80)
  name         String     @db.VarChar(100)
  isActive     Boolean    @default(true) @map("is_active")
  remark       String?    @db.VarChar(500)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdBy    String     @map("created_by") @db.Uuid
  updatedBy    String     @map("updated_by") @db.Uuid
  deletedAt    DateTime?  @map("deleted_at")
  deletedBy    String?    @map("deleted_by") @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])
  employees    Employee[]

  @@unique([departmentId, code])
  @@index([departmentId, isActive])
  @@map("positions")
}

model Employee {
  id             String     @id @default(uuid()) @db.Uuid
  employeeNo     String     @unique @map("employee_no") @db.VarChar(80)
  name           String     @db.VarChar(100)
  departmentId   String     @map("department_id") @db.Uuid
  positionId     String     @map("position_id") @db.Uuid
  employeeType   String     @map("employee_type") @db.VarChar(40)
  employmentStatus String   @default("active") @map("employment_status") @db.VarChar(30)
  userId         String?    @map("user_id") @db.Uuid
  hiredOn       DateTime?   @map("hired_on") @db.Date
  leftOn        DateTime?   @map("left_on") @db.Date
  remark         String?    @db.VarChar(500)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  createdBy      String     @map("created_by") @db.Uuid
  updatedBy      String     @map("updated_by") @db.Uuid
  deletedAt      DateTime?  @map("deleted_at")
  deletedBy      String?    @map("deleted_by") @db.Uuid
  department     Department @relation(fields: [departmentId], references: [id])
  position       Position   @relation(fields: [positionId], references: [id])
  operationRates OperationRate[]

  @@index([departmentId, employmentStatus])
  @@index([positionId, employmentStatus])
  @@map("employees")
}

model ProductionLocation {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(150)
  locationType String    @map("location_type") @db.VarChar(30)
  contactName  String?   @map("contact_name") @db.VarChar(100)
  contactPhone String?   @map("contact_phone") @db.VarChar(50)
  address      String?   @db.VarChar(500)
  isActive     Boolean   @default(true) @map("is_active")
  remark       String?   @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdBy    String    @map("created_by") @db.Uuid
  updatedBy    String    @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by") @db.Uuid

  @@unique([name, locationType])
  @@index([locationType, isActive])
  @@map("production_locations")
}

model OperationCatalog {
  id             String              @id @default(uuid()) @db.Uuid
  operationCode  String?             @unique @map("operation_code") @db.VarChar(80)
  operationName  String              @map("operation_name") @db.VarChar(150)
  defaultUnitId  String?             @map("default_unit_id") @db.Uuid
  isActive       Boolean             @default(true) @map("is_active")
  remark         String?             @db.VarChar(500)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  createdBy      String              @map("created_by") @db.Uuid
  updatedBy      String              @map("updated_by") @db.Uuid
  deletedAt      DateTime?           @map("deleted_at")
  deletedBy      String?             @map("deleted_by") @db.Uuid
  defaultUnit    Unit?               @relation(fields: [defaultUnitId], references: [id])
  rates          OperationRate[]

  @@map("operation_catalogs")
}

model OperationRate {
  id             String           @id @default(uuid()) @db.Uuid
  employeeId     String           @map("employee_id") @db.Uuid
  operationId    String           @map("operation_id") @db.Uuid
  wageMode       String           @map("wage_mode") @db.VarChar(20)
  unitPrice      Decimal          @map("unit_price") @db.Decimal(18, 4)
  effectiveFrom  DateTime         @map("effective_from") @db.Date
  effectiveTo    DateTime?        @map("effective_to") @db.Date
  remark         String?          @db.VarChar(500)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  createdBy      String           @map("created_by") @db.Uuid
  updatedBy      String           @map("updated_by") @db.Uuid
  deletedAt      DateTime?        @map("deleted_at")
  deletedBy      String?          @map("deleted_by") @db.Uuid
  employee       Employee         @relation(fields: [employeeId], references: [id])
  operation      OperationCatalog @relation(fields: [operationId], references: [id])

  @@index([employeeId, operationId, wageMode, effectiveFrom])
  @@map("operation_rates")
}
