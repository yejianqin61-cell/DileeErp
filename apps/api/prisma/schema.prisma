/// 收支流水：老表 `收支明细表.xls` 的数据源，「收支管理」板块的手工录入对象。
///
/// 与收付款单**不做自动联动**（用户 R6 选定「手工录入」）：`sourceType` / `sourceId` 本期恒空，
/// 是为将来联动预留的列。已确认的已知代价：收付款单过账后不会自动出现在这里，财务需要手工补录。
model CashFlowEntry {
  id                  String             @id @default(uuid()) @db.Uuid
  entryNo             String             @unique @map("entry_no") @db.VarChar(100)
  entryDate           DateTime           @map("entry_date") @db.Date
  /// 「对方名称」：老表要求一个统一字段；收付款单那边是 payerName / payeeName 分开且可为空
  counterpartyName    String             @map("counterparty_name") @db.VarChar(200)
  /// income / expense。金额恒为正数，方向由本字段决定（不存负数：否则「支出填成负数」无法校验）
  direction           String             @db.VarChar(10)
  amount              Decimal            @db.Decimal(18, 4)
  currency            String             @db.VarChar(10)
  exchangeRate        Decimal?           @map("exchange_rate") @db.Decimal(18, 6)
  localAmount         Decimal?           @map("local_amount") @db.Decimal(18, 4)
  /// 会计科目（分类 + 项目）。2026-09-17 之前这里是「收支项目」字典项，用户要求两者合并成一个。
  ///
  /// ⚠️ 这是**销账那条现金分录的对方科目**：已挂账的付款是「应付账款」、收款是「应收账款」。
  /// 它同时是从这条流水生成凭证时凭证上的对方科目 —— 所以不要拿它去装"这笔钱算什么"。
  subjectId           String             @map("subject_id") @db.Uuid
  /// 收支类目（2026-10-13）：**这笔钱算什么** —— 取本次核销单据上写的科目
  /// （应付：条目 > 覆盖它的对账单；应收：覆盖它的应收对账单），单据上没有就按来源类型的候选链
  /// （采购 → 原材料/主营业务成本、收款 → 主营业务收入）。手工流水留空（主科目就是它的类目）。
  ///
  /// 为什么与 `subjectId` 分两列而不是改后者：已挂账的付款，从流水生成凭证要用「应付账款」；
  /// 拿类目去当对方科目会把成本重复记一次（挂账那一步已经借过），而账面上看不出来。
  /// 可空 + `SetNull`：它是展示用的业务分类，不是记账依据，删科目不该被它挡住。
  categorySubjectId   String?            @map("category_subject_id") @db.Uuid
  settlementMethod    String?            @map("settlement_method") @db.VarChar(50)
  settlementAccountId String?            @map("settlement_account_id") @db.Uuid
  /// 资金实际所在的**银行账户**（银行账户池 banks）。与 settlementAccountId（老表结算方式字典）是两回事：
  /// 字典是给人看的「转账--农业银行5706」，这里才是算银行余额的账。可空：历史流水与「不确定走哪张卡」的流水。
  bankId              String?            @map("bank_id") @db.Uuid
  /// 本期恒空，为将来与收付款单联动预留
  sourceType          String?            @map("source_type") @db.VarChar(40)
  sourceId            String?            @map("source_id") @db.Uuid
  /// 款项性质：定金 / 货款 / 尾款 / 其他（`PAYMENT_NATURES` 的 key）。
  ///
  /// 为什么需要它：老表 `example/财务/外汇一览表.xlsx` 把每个订单的到账拆成
  /// 「定金（日期+金额）/ 货款（日期+金额）」两组，用户 2026-09-17 要求把这套口径搬进系统。
  /// 系统里「钱进来」只有两条路 ——【确认应收】自动写一条流水、【收支流水】手工录一笔 ——
  /// 两条都落在本表上，所以标记只能加在这条**真正记了钱**的记录上（而不是某个单据上）。
  ///
  /// 可空：历史流水与「确实无所谓性质」的流水（房租、水电）不该被迫选一个。
  /// 报表把未标注的算进「其他到账」并留一行说明，不替财务猜。
  paymentNature       String?            @map("payment_nature") @db.VarChar(20)
  /// 订单号：把收入流水挂到具体订单。
  ///
  /// 为什么必须有：定金在**出货之前**就收到了，那时系统里还没有应收来源（应收来自成品出库），
  /// 因此手工录的定金流水没有任何自动来源可挂；外汇一览表要按订单归集定金，只能靠这个字段。
  /// 可空：非订单类收支（房租、水电、退税…）本来就没有订单号。
  orderNo             String?            @map("order_no") @db.VarChar(100)
  salesOrderId        String?            @map("sales_order_id") @db.Uuid
  salesOrder          SalesOrder?        @relation(fields: [salesOrderId], references: [id])
  /// posted（生效）/ reversed（已冲销，保留行但报表不计入）
  status              String             @default("posted") @db.VarChar(30)
  remark              String?            @db.VarChar(1000)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  createdBy           String             @map("created_by") @db.Uuid
  updatedBy           String             @map("updated_by") @db.Uuid
  deletedAt           DateTime?          @map("deleted_at")
  deletedBy           String?            @map("deleted_by") @db.Uuid
  subject             AccountingSubject  @relation(fields: [subjectId], references: [id])
  /// 收支类目（见上面 `categorySubjectId`）。可空 + SET NULL（刻意不是 RESTRICT）。
  categorySubject     AccountingSubject? @relation("CashFlowCategorySubject", fields: [categorySubjectId], references: [id], onDelete: SetNull)
  settlementAccount   DictionaryItem?    @relation("CashFlowAccount", fields: [settlementAccountId], references: [id])
  bank                Bank?              @relation(fields: [bankId], references: [id])
  voucherLines        VoucherLine[]

  @@index([entryDate, currency])
  @@index([subjectId, direction])
  @@index([categorySubjectId])
  @@index([currency, status])
  @@index([bankId, status])
  /// 外汇一览表按订单号归集收款（定金流水没有来源可挂，只能按订单号找）。
  @@index([orderNo])
  @@map("cash_flow_entries")
}

/// 会计科目（全站财务口径的唯一来源）。
///
/// 来源与口径：用户 2026-09-17 交付 `example/财务/科目表(2).xls`，口径原文
/// 「那个编码的可以不管，分类就对应的是科目类别，项目就对应的是科目名称」。
/// 因此**只有两级**：`category`（分类）+ `name`（项目）；老表的科目代码整列不采纳。
///
/// 为什么不是 `dictionary_items` 的一种字典类型：科目表有「分类」这个维度，
/// 而 `dictionary_items` 是平表；硬塞一列 `category` 会让所有字典都背上一个只有本科目表
/// 才有意义的字段。用户也明确要求「收支项目维护和会计科目合并成一个会计科目」——
/// 合并后的东西是科目，不是字典。
///
/// 为什么 `balanceDirection` 留着：本期不参与计算，但凭证/账簿要靠它判断科目的自然余额方向；
/// 现在丢掉，以后要再问一次财务。
model AccountingSubject {
  id                          String                          @id @default(uuid()) @db.Uuid
  /// 分类 = 科目类别（资产类 / 负债类 / 成本类 / 所有者权益类 / 损益类）。
  category                    String                          @db.VarChar(30)
  /// 项目 = 科目名称（老表 B 列原文，含「销售- 办产地证」这类原表手误空格，照抄不改）。
  name                        String                          @db.VarChar(100)
  /// 余额方向：借 / 贷（老表 D 列原文）。本期只作口径参考，不参与任何计算。
  balanceDirection            String?                         @map("balance_direction") @db.VarChar(4)
  sortOrder                   Int                             @default(0) @map("sort_order")
  /// 停用而非删除：已被流水/单据引用的科目必须留成历史快照（宪法《Configurable Business Categories》）。
  isActive                    Boolean                         @default(true) @map("is_active")
  createdAt                   DateTime                        @default(now()) @map("created_at")
  updatedAt                   DateTime                        @updatedAt @map("updated_at")
  createdBy                   String                          @map("created_by") @db.Uuid
  updatedBy                   String                          @map("updated_by") @db.Uuid
  deletedAt                   DateTime?                       @map("deleted_at")
  deletedBy                   String?                         @map("deleted_by") @db.Uuid
  cashFlowEntries             CashFlowEntry[]
  /// 被用作「收支类目」的流水（2026-10-13）。与上面那条是一对**具名**关系，不能合并。
  cashFlowCategoryEntries     CashFlowEntry[]                 @relation("CashFlowCategorySubject")
  customerPayments            CustomerPayment[]
  supplierPayments            SupplierPayment[]
  /// 应付条目上的科目：目前只有「其他应付」在建单/导入时手选（见 `SupplierPayableEntry.subjectId`）。
  supplierPayableEntries      SupplierPayableEntry[]
  salaryPayments              SalaryPayment[]
  receivableReconciliations   ReceivableReconciliation[]
  payableReconciliations      SupplierPayableReconciliation[]
  /// 凭证分录上的记账科目（2026-11-09 R3，见 `VoucherLine.subjectId`）。
  voucherLines                VoucherLine[]                   @relation("VoucherLineSubject")
  /// 凭证分录上的业务科目（辅助核算维度，见 `VoucherLine.businessSubjectId`）。
  voucherLineBusinessSubjects VoucherLine[]                   @relation("VoucherLineBusinessSubject")

  /// 同类别内科目名唯一：迁移与 seed 靠它做幂等种入。
  /// 不设全局唯一是有意的 —— 将来财务要在两个类别下各建一个同名明细科目时不必再迁移一次。
  @@unique([category, name])
  @@index([category, sortOrder])
  @@map("accounting_subjects")
}

/// 会计科目类目（2026-11-07 起类目成为一等实体）。
///
/// 为什么要这张表：`accounting_subjects.category` 仍是字符串（三大报表/凭证按类目名硬编码匹配，
/// 改成外键反而要把名字在运行时翻译一遍，见设计文档 §2），但「类目清单」必须可增删改：
/// 改名要在一个事务里级联改全部科目行、删除要能判断「这个类目下还有没有科目」、
/// 新增要留下可审计的记录 —— 派生清单（`SELECT DISTINCT category`）给不了这些。
///
/// 不设 `deleted_at`：类目行不承载任何业务事实，删除是**物理删除**；只有「还有科目」时才拒绝删除
/// （见 `AccountingSubjectCategoryService.remove`）。软删 + 唯一索引会让「删掉写错的类目 → 用同名重建」
/// 永远做不到。
model AccountingSubjectCategory {
  id        String   @id @default(uuid()) @db.Uuid
  /// 类目名，全表唯一（目录名就是业务键；改名是服务层的事务级联操作）。
  name      String   @unique @db.VarChar(30)
  /// 排序权重：5 个内置类目 = 10/20/30/40/50（会计制度顺序），自建类目接在最大值之后 +10。
  sortOrder Int      @default(0) @map("sort_order")
  /// 内置类目（会计制度五类）：**不许改名、不许删除** —— 三大报表与凭证按这五个名字匹配科目。
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String   @map("created_by") @db.Uuid
  updatedBy String   @map("updated_by") @db.Uuid

  @@index([sortOrder])
  @@map("accounting_subject_categories")
}

/// 记账凭证。
///
/// 为什么是**结构化记录**而不是一张图片：凭证是账务事实，必须可查、可核、可追溯、可重打；
/// 图片不可搜索/不可复制/不可校对，且改一个字就要重新生成。图片（或 PDF）只是它的**渲染视图**：
/// 前端按「记账凭证纸」排版，浏览器打印 / 另存为 PDF 即可。
///
/// 当前来源只有 `cash_flow_entry`（每条收支流水一张凭证）与 `voucher`（红冲产生的红字凭证）。
model Voucher {
  id          String        @id @default(uuid()) @db.Uuid
  voucherNo   String        @unique @map("voucher_no") @db.VarChar(100)
  voucherDate DateTime      @map("voucher_date") @db.Date
  /// 会计期间 YYYY-MM（取自凭证日期），便于按期间出凭证清单
  period      String        @db.VarChar(7)
  /// 来源单据类型：cash_flow_entry（由收支流水生成）/ voucher（红冲）/ manual（财务手工录入）
  sourceType  String        @map("source_type") @db.VarChar(40)
  /// 来源单据 id。**手工凭证为 null**（它没有来源单据）；
  /// 唯一索引 (source_type, source_id) 不约束 NULL，所以「一条来源一张凭证」对流水来源依然成立。
  sourceId    String?       @map("source_id") @db.Uuid
  summary     String        @db.VarChar(500)
  currency    String        @db.VarChar(10)
  /// 借贷合计（生成/编辑时校验相等；两边恒为正数，方向由分录的 direction 决定）
  debitTotal  Decimal       @map("debit_total") @db.Decimal(18, 4)
  creditTotal Decimal       @map("credit_total") @db.Decimal(18, 4)
  /// draft（可改可删）/ posted（已过账，不可改，只能红冲）/ reversed（已红冲）
  status      String        @default("draft") @db.VarChar(30)
  attachment  Json          @default("[]")
  remark      String?       @db.VarChar(1000)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  createdBy   String        @map("created_by") @db.Uuid
  updatedBy   String        @map("updated_by") @db.Uuid
  deletedAt   DateTime?     @map("deleted_at")
  deletedBy   String?       @map("deleted_by") @db.Uuid
  lines       VoucherLine[]

  /// 一条来源只能有**一张有效的**凭证 —— 生成接口因此天然幂等（重复点就是返回原凭证）。
  ///
  /// ⚠️ 2026-11-09 R3 起这里**不再是全局唯一键**：改成**部分唯一索引**
  /// `vouchers_source_active_key (source_type, source_id) WHERE deleted_at IS NULL AND status <> 'reversed' AND source_id IS NOT NULL`
  /// （DDL 见迁移 `20261109130000_finance_governance_r3`；Prisma schema 表达不了部分索引，所以这里只留普通索引，
  /// 由迁移保证）。为什么必须改：全局唯一键让「挂账凭证红冲后按来源重算」永远建不出第二张
  /// （红冲行占着 (source_type, source_id)），只能 422 卡死。改成部分索引后：红冲行不再占键，
  /// 重算可以建新凭证，而「同一来源同时只有一张有效凭证」仍然成立。
  @@index([sourceType, sourceId])
  @@index([period, status])
  @@index([voucherDate])
  @@map("vouchers")
}

/// 建账期初余额（财务 2026-09-24：三大报表的起点）。
///
/// 为什么需要它：银行账户档案里只有**货币资金**的期初余额，其它科目没有 —— 只把货币资金期初加进
/// 资产侧，资产负债表会一直差一个「期初余额」的差额（勾稽不平，看起来像报表算错了）。
/// 财务录一次全科目的期初（试算平衡的借/贷两侧），报表的勾稽才真正为 0。
///
/// 三条口径：
///   1. 金额存「方向 + 正数金额」，不存负数（与 `voucher_lines` / `cash_flow_entries` 同一约定：库层不存负数）；
///   2. 科目用与凭证同一套键 `分类/名称`（`subject_key`），这样期初与凭证的余额能直接相加；
///   3. `as_of_date` 是**建账日期**：余额是这一天之前的累计。报表取数 = 建账期初 + 建账日之后的凭证，
///      两边不会重复计算（见 `finance-three-statements.service.ts`）。
model AccountingOpeningBalance {
  id           String    @id @default(uuid()) @db.Uuid
  asOfDate     DateTime  @map("as_of_date") @db.Date
  subjectKey   String    @map("subject_key") @db.VarChar(200)
  subjectLabel String    @map("subject_label") @db.VarChar(200)
  currency     String    @db.VarChar(10)
  /// debit / credit（借/贷余额，与凭证分录同一套方向词）
  direction    String    @db.VarChar(10)
  amount       Decimal   @db.Decimal(18, 4)
  remark       String?   @db.VarChar(1000)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdBy    String    @map("created_by") @db.Uuid
  updatedBy    String    @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by") @db.Uuid

  /// 同一建账日 + 同一科目 + 同一币种只有一行。**软删除后仍占着这个键**（与月度管理费分摊同一处理）：
  /// 服务层「整批替换」时按这个三元组 upsert（把软删的那条恢复回来），所以唯一索引成立，也不会出现
  /// 「同一科目两条期初，报表用哪条」的歧义。
  @@unique([asOfDate, subjectKey, currency])
  @@index([asOfDate, currency])
  @@map("accounting_opening_balances")
}

/// 期末汇率：财务每月维护一次，「1 外币 = rate 人民币」。
///
/// 为什么需要它：凭证上有 `currency` 但没有汇率，而三大报表是**人民币**报表 ——
/// 不折算就只能按币种分列（表尾写「不跨币种相加」），财务拿到的不是一张能对外报的表。
/// 折算的口径（哪个时点用哪个月的汇率）写在 `finance-three-statements.service.ts` 的注释里。
model ExchangeRate {
  id        String    @id @default(uuid()) @db.Uuid
  /// 汇率所属期间 `YYYY-MM`（期末汇率是「某月月末」的汇率，按月维护；不用记账日期——
  /// 财务维护的是「9 月的汇率」，而不是「9 月 30 日那天的汇率」，月底最后一天是几号不该影响取数）
  period    String    @db.VarChar(7)
  /// 外币币种（本币 CNY 不录：本币对自身恒为 1，录进来只会多一个「报表到底用哪条」的歧义）
  currency  String    @db.VarChar(10)
  /// 1 外币 = rate 人民币。精度 DECIMAL(18,8) 见 `money.ts` 的 `RATE_SCALE` 注释
  rate      Decimal   @db.Decimal(18, 8)
  remark    String?   @db.VarChar(1000)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String    @map("created_by") @db.Uuid
  updatedBy String    @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  /// 同一期间 + 同一币种只有一行。**软删除后仍占着这个键**（与期初余额 / 月度分摊同一处理）：
  /// 「整批替换」时按这个二元组 upsert（把软删的那条恢复回来），所以不会出现
  /// 「同一期间同一币种两条汇率、报表取哪条」这种查不出来的错。
  @@unique([period, currency])
  @@index([currency, period])
  @@map("exchange_rates")
}

/// 凭证分录：借/贷各一行或多行。金额恒为正数，方向由 direction 决定（与收支流水同一约定）。
model VoucherLine {
  id                   String             @id @default(uuid()) @db.Uuid
  voucherId            String             @map("voucher_id") @db.Uuid
  lineNo               Int                @map("line_no")
  /// debit / credit
  direction            String             @db.VarChar(10)
  /// 科目编码：当前取自「收支项目」字典的 key；将来接正式科目表时只改这一处取值来源
  subjectKey           String             @map("subject_key") @db.VarChar(200)
  /// 科目名快照：字典改名/停用后，历史凭证仍显示记账当时的科目名
  subjectLabel         String             @map("subject_label") @db.VarChar(200)
  summary              String             @db.VarChar(500)
  amount               Decimal            @db.Decimal(18, 4)
  currency             String             @db.VarChar(10)
  cashFlowEntryId      String?            @map("cash_flow_entry_id") @db.Uuid
  /// 资金类分录引用**具体的银行账户**（用户要求「会计科目的银行存款要引用具体的银行账户」）：
  /// 有它才能按账户出「银行存款明细账」、才能与银行对账单逐笔核对。科目名仍是「银行存款」，
  /// 这一列是明细/辅助核算引用；库存现金分录与手工改成非资金类科目的分录为 null。
  bankId               String?            @map("bank_id") @db.Uuid
  /// 记账科目 id（2026-11-09 R3）：`subject_label` 只是文本快照；报表与明细账要按科目 id 归集，
  /// 否则科目改名、同名跨类目、历史手工名（不在科目主数据里）都会让报表金额对不上账。
  /// 可空：历史行与「找不到唯一同名科目」的行留空，读取方回退 `subject_label`。
  subjectId            String?            @map("subject_id") @db.Uuid
  /// 业务科目（辅助核算维度，2026-11-09 R3）：单据上写的科目（应付条目科目 / 流水「收支类目」）。
  /// 只用于展示与辅助核算，**不决定借贷方向**；`businessSubjectLabel` 是它的名称快照。
  businessSubjectId    String?            @map("business_subject_id") @db.Uuid
  businessSubjectLabel String?            @map("business_subject_label") @db.VarChar(200)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  createdBy            String             @map("created_by") @db.Uuid
  updatedBy            String             @map("updated_by") @db.Uuid
  voucher              Voucher            @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  cashFlowEntry        CashFlowEntry?     @relation(fields: [cashFlowEntryId], references: [id])
  bank                 Bank?              @relation(fields: [bankId], references: [id], onDelete: SetNull)
  /// 见 `subjectId`：记账科目主数据引用。SetNull：科目行若被物理清理（正常只停用），
  /// 分录仍保留 `subject_label` 快照，不会让历史凭证消失。
  subject              AccountingSubject? @relation("VoucherLineSubject", fields: [subjectId], references: [id], onDelete: SetNull)
  /// 见 `businessSubjectId`：业务科目（辅助核算维度）。
  businessSubject      AccountingSubject? @relation("VoucherLineBusinessSubject", fields: [businessSubjectId], references: [id], onDelete: SetNull)

  @@unique([voucherId, lineNo])
  @@index([bankId])
  @@index([subjectId])
  @@index([businessSubjectId])
  @@map("voucher_lines")
}

model ProductionOrder {
  id                           String                              @id @default(uuid()) @db.Uuid
  productionOrderNo            String                              @unique @map("production_order_no") @db.VarChar(100)
  orderNo                      String                              @map("order_no") @db.VarChar(100)
  salesOrderId                 String                              @map("sales_order_id") @db.Uuid
  bomId                        String?                             @map("bom_id") @db.Uuid
  bomVersion                   Int?                                @map("bom_version")
  bomSnapshot                  Json?                               @map("bom_snapshot")
  productionOrderType          String                              @default("standard") @map("production_order_type") @db.VarChar(30)
  parentProductionOrderId      String?                             @map("parent_production_order_id") @db.Uuid
  executionMode                String                              @map("execution_mode") @db.VarChar(20)
  executionLocationId          String                              @map("execution_location_id") @db.Uuid
  plannedQuantity              Decimal                             @map("planned_quantity") @db.Decimal(18, 4)
  unitId                       String                              @map("unit_id") @db.Uuid
  productSpecification         String?                             @map("product_specification") @db.VarChar(1000)
  productionProcessNote        String?                             @map("production_process_note") @db.VarChar(2000)
  status                       String                              @default("draft") @db.VarChar(30)
  plannedStartedOn             DateTime?                           @map("planned_started_on") @db.Date
  deliveryDueOn                DateTime?                           @map("delivery_due_on") @db.Date
  startedOn                    DateTime?                           @map("started_on") @db.Date
  completedOn                  DateTime?                           @map("completed_on") @db.Date
  actualCompletedQuantity      Decimal?                            @map("actual_completed_quantity") @db.Decimal(18, 4)
  remark                       String?                             @db.VarChar(1000)
  createdAt                    DateTime                            @default(now()) @map("created_at")
  updatedAt                    DateTime                            @updatedAt @map("updated_at")
  createdBy                    String                              @map("created_by") @db.Uuid
  updatedBy                    String                              @map("updated_by") @db.Uuid
  deletedAt                    DateTime?                           @map("deleted_at")
  deletedBy                    String?                             @map("deleted_by") @db.Uuid
  salesOrder                   SalesOrder                          @relation(fields: [salesOrderId], references: [id])
  bom                          Bom?                                @relation(fields: [bomId], references: [id])
  parent                       ProductionOrder?                    @relation("production_order_parent", fields: [parentProductionOrderId], references: [id])
  children                     ProductionOrder[]                   @relation("production_order_parent")
  executionLocation            ProductionLocation                  @relation(fields: [executionLocationId], references: [id])
  unit                         Unit                                @relation(fields: [unitId], references: [id])
  operations                   ProductionOrderOperation[]
  inventoryFacts               InventoryFact[]
  rawMaterialMovements         RawMaterialMovement[]
  operationDailyReports        OperationDailyReport[]
  employeeDailyReports         EmployeeDailyReport[]
  productionDailyAlerts        ProductionDailyAlert[]
  payrollSources               ProductionPayrollSource[]
  outsourceLogisticsBatches    OutsourceLogisticsBatch[]
  outsourceReturnTransfers     OutsourceReturnTransfer[]
  outsourceDirectShipments     OutsourceDirectShipment[]
  finishedGoodsInspections     FinishedGoodsInspectionSubmission[]
  finishedGoodsInbounds        FinishedGoodsInbound[]
  finishedGoodsDefectives      FinishedGoodsDefective[]
  finishedGoodsOutbounds       FinishedGoodsOutbound[]
  finishedGoodsOutboundNotices FinishedGoodsOutboundNotice[]
  inboundNotices               FinishedGoodsInboundNotice[]
  customerReturns              CustomerReturn[]

  @@index([orderNo, status])
  @@index([salesOrderId, productionOrderType])
  @@map("production_orders")
}

model RawMaterialMovement {
  id                         String                    @id @default(uuid()) @db.Uuid
  movementNo                 String                    @unique @map("movement_no") @db.VarChar(100)
  documentType               String                    @default("issue") @map("document_type") @db.VarChar(30)
  status                     String                    @default("draft") @db.VarChar(30)
  productionOrderId          String                    @map("production_order_id") @db.Uuid
  // 领料单归属到具体工序：同一生产单下不同工序领的物料不同（订单号-生产单-工序-领料表）。
  // 历史数据没有工序，因此列可空；新建领料单由服务层强制要求。
  productionOrderOperationId String?                   @map("production_order_operation_id") @db.Uuid
  orderNo                    String                    @map("order_no") @db.VarChar(100)
  salesOrderId               String?                   @map("sales_order_id") @db.Uuid
  salesOrder                 SalesOrder?               @relation(fields: [salesOrderId], references: [id])
  businessDate               DateTime                  @map("business_date") @db.Date
  reason                     String?                   @db.VarChar(1000)
  remark                     String?                   @db.VarChar(1000)
  /// 生产「确认提交」到仓库的时刻（draft → pending_outbound）。
  /// 为什么单独一列而不是复用 updatedAt：updatedAt 会被任何一次写入改动，
  /// 而仓库的「待出库通知」要显示的是「这张单是什么时候交过来的」，两次提交之间不能漂移。
  submittedAt                DateTime?                 @map("submitted_at")
  idempotencyKey             String                    @unique @map("idempotency_key") @db.VarChar(200)
  createdAt                  DateTime                  @default(now()) @map("created_at")
  updatedAt                  DateTime                  @updatedAt @map("updated_at")
  createdBy                  String                    @map("created_by") @db.Uuid
  updatedBy                  String                    @map("updated_by") @db.Uuid
  deletedAt                  DateTime?                 @map("deleted_at")
  deletedBy                  String?                   @map("deleted_by") @db.Uuid
  productionOrder            ProductionOrder           @relation(fields: [productionOrderId], references: [id])
  productionOrderOperation   ProductionOrderOperation? @relation(fields: [productionOrderOperationId], references: [id])
  lines                      RawMaterialMovementLine[]
  risks                      RawMaterialMovementRisk[]

  @@index([productionOrderId, status])
  @@index([productionOrderOperationId])
  @@index([orderNo, businessDate])
  /// 仓库「待出库通知」按 (status, submitted_at) 查最新待出库单据（索引由 20260916130000 迁移创建）。
  /// 必须在这里声明：手写迁移建了索引而 schema 不声明，`prisma migrate diff` 会一直想把它 DROP 掉，
  /// 形成永久漂移（同一个坑在仓库里已有 9 处历史遗留）。
  @@index([status, submittedAt])
  @@map("raw_material_movements")
}

