POSTGRES_DB=dilee_erp
POSTGRES_USER=dilee
POSTGRES_PASSWORD=replace-with-a-long-random-password
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-at-least-10-characters
INITIAL_ADMIN_DISPLAY_NAME=迪礼管理员
COOKIE_SECURE=false
# 生产 Agent：分别使用业务表只读账号和仅限 agent_* 表的状态账号；不要复用 DATABASE_URL。
AGENT_READ_DATABASE_URL=postgresql://agent_read:replace-with-readonly-password@127.0.0.1:15432/dilee_erp?schema=public
AGENT_STATE_DATABASE_URL=postgresql://agent_state:replace-with-agent-state-password@127.0.0.1:15432/dilee_erp?schema=public
AGENT_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
# 回退开关：设为 false 会拒绝所有业务查询 Agent 路由，不删除 agent_* 历史数据。
BUSINESS_QUERY_ENABLED=true
