{
  "name": "dilee-erp",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build --workspace=@dilee/api && node --test apps/api/test/*.test.cjs apps/api/test/unit/**/*.test.cjs",
    "test:unit": "npm run build --workspace=@dilee/api && node --test apps/api/test/*.test.cjs apps/api/test/unit/**/*.test.cjs",
    "test:api": "node scripts/run-tests.mjs api",
    "test:api:raw": "node --test apps/api/test/http/**/*.test.cjs",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:integration:raw": "node --test apps/api/test/integration/**/*.test.cjs",
    "db:test:prepare": "node scripts/prepare-test-database.mjs",
    "db:seed:mock": "node scripts/seed-mock-data.mjs",
    "test:e2e": "node scripts/run-tests.mjs e2e",
    "test:e2e:raw": "playwright test",
    "verify:quick": "node scripts/verify-quality.mjs quick",
    "verify:chain": "node scripts/verify-quality.mjs chain",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate:deploy": "powershell -ExecutionPolicy Bypass -File scripts/apply-migrations.ps1"
    ,"factory:config": "docker compose -f docker-compose.factory.yml --env-file .env.factory config"
    ,"factory:up": "docker compose -f docker-compose.factory.yml --env-file .env.factory up -d --build"
    ,"factory:down": "docker compose -f docker-compose.factory.yml --env-file .env.factory down"
    ,"factory:logs": "docker compose -f docker-compose.factory.yml --env-file .env.factory logs -f --tail=200"
    ,"test:performance": "node --test scripts/perf-gate.test.mjs"
    ,"perf:gate": "node scripts/perf-gate.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
