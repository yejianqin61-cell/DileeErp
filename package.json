{
  "name": "dilee-erp",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run typecheck && npm run test:unit",
    "test:unit": "npm run test:deploy && npm run test:unit:api && npm run test:unit:web",
    "test:deploy": "node --test scripts/deploy-scripts.test.mjs",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy-incremental.ps1",
    "test:unit:api": "npm run build --workspace=@dilee/api && node --test apps/api/test/*.test.cjs apps/api/test/unit/**/*.test.cjs",
    "test:unit:web": "npm run test:unit --workspace=@dilee/web",
    "test:coverage": "npm run test:coverage:api && npm run test:coverage:web",
    "test:coverage:api": "npm run build --workspace=@dilee/api && node --test --experimental-test-coverage apps/api/test/*.test.cjs apps/api/test/unit/**/*.test.cjs",
    "test:coverage:web": "npm run test:coverage --workspace=@dilee/web",
    "test:api": "node scripts/run-tests.mjs api",
    "test:api:raw": "node --test --test-concurrency=1 apps/api/test/http/**/*.test.cjs",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:integration:raw": "node --test apps/api/test/integration/**/*.test.cjs",
    "db:test:prepare": "node scripts/prepare-test-database.mjs",
    "db:test:provision": "node scripts/provision-test-databases.mjs",
    "db:seed:mock": "node scripts/seed-mock-data.mjs",
    "test:e2e": "node scripts/run-tests.mjs e2e",
    "test:e2e:raw": "playwright test",
    "verify:quick": "node scripts/verify-quality.mjs quick",
    "verify:chain": "node scripts/verify-quality.mjs chain",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate:deploy": "powershell -ExecutionPolicy Bypass -File scripts/apply-migrations.ps1",
    "compose:config": "docker compose config",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f --tail=200",
    "test:performance": "node --test scripts/perf-gate.test.mjs",
    "perf:gate": "node scripts/perf-gate.mjs",
    "release:pack": "powershell -ExecutionPolicy Bypass -File scripts/create-release-archive.ps1",
    "release:verify": "node scripts/verify-release-archive.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
